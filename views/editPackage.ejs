<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Data Paket</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">

</head>
<body class="bg-light">
  <div class="container py-5">
    <h2 class="mb-4 text-center">Edit Data Paket</h2>
    <div class="card shadow-sm">
      <div class="card-body">
        <form method="POST" action="/package/edit/<%= pkg._id %>">
          <div class="mb-3">
            <label class="form-label">Nama Penerima</label>
            <input type="text" name="recipient" class="form-control" value="<%= pkg.recipient %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Nama Kurir</label>
            <input type="text" name="courier" class="form-control" value="<%= pkg.courier %>" required>
          </div>
          <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
          <a href="/package" class="btn btn-secondary">Batal</a>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
