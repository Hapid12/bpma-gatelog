<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rekap Laporan - BPMA GateLog</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    
    .nav-tabs .nav-link { color: #64748b; border: none; border-bottom: 2px solid transparent; }
    .nav-tabs .nav-link:hover { color: #1e3a8a; border-color: transparent; }
    .nav-tabs .nav-link.active { color: #1e3a8a; background-color: transparent; border-color: #1e3a8a; font-weight: 600; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased overflow-hidden font-sans">
  
  <div class="flex h-screen w-screen overflow-hidden">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-[#1e3a8a] border-r border-[#1e3a8a]/20 flex flex-col justify-between shrink-0 z-20">
      <div>
        <div class="flex items-center px-6 py-5 border-b border-[#1e3a8a]/20">
          <svg class="w-8 h-8 mr-2.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3C12 3 6 8.5 6 13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13C18 8.5 12 3 12 3Z" fill="url(#leafGradient)"/>
            <path d="M12 8C12 8 9.5 11 9.5 13C9.5 14.3807 10.6193 15.5 12 15.5C13.3807 15.5 14.5 14.3807 14.5 13C14.5 11 12 8 12 8Z" fill="#FFFFFF"/>
            <defs>
              <linearGradient id="leafGradient" x1="6" y1="3" x2="18" y2="19" gradientUnits="userSpaceOnUse">
                <stop stop-color="#10B981"/>
                <stop stop-color="#059669"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="flex flex-col">
            <span class="text-base font-bold tracking-wider text-white">BPMA</span>
            <span class="text-xs font-semibold tracking-wide text-[#5ca82f] -mt-1">GateLog</span>
          </div>
        </div>

        <nav class="flex-1 px-4 space-y-1.5 py-6">
          <a href="/" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-grid-fill mr-3 text-base"></i><span>Dashboard</span>
          </a>
          <a href="/visitor" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-people mr-3 text-base"></i><span>Visitor</span>
          </a>
          <a href="/package" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-box-seam mr-3 text-base"></i><span>Paket Masuk</span>
          </a>
          <a href="/appointment" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-calendar-event mr-3 text-base"></i><span>Appointment</span>
          </a>
          <a href="/approval" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-shield-check mr-3 text-base"></i><span>Approval</span>
          </a>
          <a href="/laporan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-[#5ca82f]/90 shadow-md shadow-[#5ca82f]/20 transition-all duration-200">
            <i class="bi bi-file-earmark-text mr-3 text-base"></i><span>Laporan</span>
          </a>
          <a href="/audit-log" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-journal-code mr-3 text-base"></i><span>Audit Log</span>
          </a>
          <a href="/pengaturan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-gear mr-3 text-base"></i><span>Pengaturan</span>
          </a>
        </nav>
      </div>

      <div class="p-4 border-t border-[#1e3a8a]/20">
        <a href="/logout" class="flex items-center justify-between p-2 rounded-lg hover:bg-rose-950/20 group cursor-pointer transition-colors duration-200">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-[#5ca82f] flex items-center justify-center font-bold text-white text-xs border border-[#5ca82f]">
              <%= user.name ? user.name[0].toUpperCase() : 'A' %>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-white"><%= user.name %></span>
              <span class="text-[9px] text-blue-200 capitalize">Role: <%= user.role %></span>
            </div>
          </div>
          <i class="bi bi-box-arrow-right text-blue-300 group-hover:text-rose-400 text-sm transition-colors"></i>
        </a>
      </div>
    </aside>

    <!-- Panel Konten Kanan -->
    <div class="flex-1 flex flex-col overflow-hidden bg-slate-50">
      
      <!-- Topbar -->
      <header class="h-20 bg-white/90 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-8 z-10 shrink-0">
        <div>
          <h1 class="text-xl font-bold text-slate-800 tracking-wide">Rekapitulasi Laporan</h1>
          <p class="text-[11px] text-slate-600 mt-0.5">Lihat, filter, dan cetak laporan bulanan</p>
        </div>
      </header>

      <!-- Area Utama Halaman -->
      <main class="flex-1 overflow-y-auto p-8 space-y-6">
        
        <!-- Filter & Aksi -->
        <div class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
          <form action="/laporan" method="GET" class="flex flex-col md:flex-row md:items-end gap-4 w-full">
            <div>
              <label for="month" class="block text-[10px] font-semibold text-slate-600 uppercase tracking-wider mb-1">Pilih Bulan</label>
              <input type="month" id="month" name="month" value="<%= monthQuery %>" class="bg-slate-50 border border-slate-200 text-slate-900 text-sm rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:border-transparent transition-all">
            </div>
            <div class="flex space-x-2">
              <button type="submit" class="bg-[#5ca82f] hover:bg-[#4d8b26] text-white font-semibold px-4 py-2.5 rounded-lg text-xs transition-colors flex items-center gap-1.5 shadow-sm hover:shadow transition-all">
                <i class="bi bi-filter"></i> Filter
              </button>
            </div>
          </form>

          <a href="/laporan/cetak?month=<%= monthQuery %>" target="_blank" class="bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold px-5 py-2.5 rounded-lg text-xs transition-colors flex items-center gap-1.5 whitespace-nowrap shadow-sm hover:shadow transition-all">
            <i class="bi bi-file-earmark-pdf text-rose-600"></i> Cetak PDF
          </a>
        </div>

        <!-- Metrik Singkat -->
        <div class="grid grid-cols-2 gap-6">
          <div class="bg-blue-500/10 border border-[#5ca82f]/20 rounded-xl p-5 flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-500/20 rounded-full flex items-center justify-center text-[#5ca82f] text-xl border border-[#5ca82f]/30">
              <i class="bi bi-people"></i>
            </div>
            <div>
              <p class="text-[10px] font-medium text-slate-600 uppercase tracking-wider">Total Visitor Bulan Ini</p>
              <h3 class="text-2xl font-bold text-slate-800 mt-0.5"><%= visitors.length %></h3>
            </div>
          </div>
          <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-5 flex items-center gap-4">
            <div class="w-12 h-12 bg-emerald-500/20 rounded-full flex items-center justify-center text-emerald-400 text-xl border border-emerald-500/30">
              <i class="bi bi-box-seam"></i>
            </div>
            <div>
              <p class="text-[10px] font-medium text-slate-600 uppercase tracking-wider">Total Paket Bulan Ini</p>
              <h3 class="text-2xl font-bold text-slate-800 mt-0.5"><%= packages.length %></h3>
            </div>
          </div>
        </div>

        <!-- Tabel Pratinjau (Tabs) -->
        <div class="bg-white shadow-sm border border-slate-200 rounded-xl overflow-hidden">
          <ul class="nav nav-tabs border-b border-slate-200 px-5 pt-3" id="reportTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active text-xs py-3" id="visitor-tab" data-bs-toggle="tab" data-bs-target="#visitor-pane" type="button" role="tab">Log Kunjungan</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link text-xs py-3" id="package-tab" data-bs-toggle="tab" data-bs-target="#package-pane" type="button" role="tab">Log Paket</button>
            </li>
          </ul>
          
          <div class="tab-content p-5" id="reportTabsContent">
            <!-- Tab Visitor -->
            <div class="tab-pane fade show active" id="visitor-pane" role="tabpanel" tabindex="0">
              <div class="overflow-x-auto max-h-[400px]">
                <table class="w-full text-left border-collapse text-[11px]">
                  <thead class="sticky top-0 bg-white">
                    <tr class="border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[9px]">
                      <th class="py-2.5 pb-2">Tanggal</th>
                      <th class="py-2.5 pb-2">Nama Tamu</th>
                      <th class="py-2.5 pb-2">Instansi</th>
                      <th class="py-2.5 pb-2">Tujuan</th>
                      <th class="py-2.5 pb-2">Status</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% if (visitors.length === 0) { %>
                      <tr><td colspan="5" class="text-center py-8 text-slate-600">Data kosong.</td></tr>
                    <% } else { %>
                      <% visitors.forEach(v => { %>
                        <tr class="text-slate-700">
                          <td class="py-2 text-slate-600 font-mono"><%= new Date(v.date).toLocaleDateString('id-ID') %></td>
                          <td class="py-2 font-semibold text-slate-800"><%= v.name %></td>
                          <td class="py-2"><%= v.institution || v.instansi || '-' %></td>
                          <td class="py-2 max-w-[150px] truncate" title="<%= v.purpose %>"><%= v.purpose %></td>
                          <td class="py-2 capitalize text-xs"><%= v.status %></td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Tab Package -->
            <div class="tab-pane fade" id="package-pane" role="tabpanel" tabindex="0">
              <div class="overflow-x-auto max-h-[400px]">
                <table class="w-full text-left border-collapse text-[11px]">
                  <thead class="sticky top-0 bg-white">
                    <tr class="border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[9px]">
                      <th class="py-2.5 pb-2">Tanggal</th>
                      <th class="py-2.5 pb-2">No. Resi</th>
                      <th class="py-2.5 pb-2">Kurir</th>
                      <th class="py-2.5 pb-2">Penerima</th>
                      <th class="py-2.5 pb-2">Status</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% if (packages.length === 0) { %>
                      <tr><td colspan="5" class="text-center py-8 text-slate-600">Data kosong.</td></tr>
                    <% } else { %>
                      <% packages.forEach(p => { %>
                        <tr class="text-slate-700">
                          <td class="py-2 text-slate-600 font-mono"><%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('id-ID') : '-' %></td>
                          <td class="py-2 font-semibold text-slate-800"><%= p.nomorResi %></td>
                          <td class="py-2"><%= p.namaKurir %></td>
                          <td class="py-2"><%= p.penerimaNama || '-' %></td>
                          <td class="py-2 capitalize text-xs"><%= p.status || 'belum diambil' %></td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <footer class="text-center text-slate-600 text-[10px] pt-12 pb-4">
          © 2026 BPMA GateLog
        </footer>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
