<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>GateLog BPMA Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter&display=swap');
      body {
        font-family: 'Inter', Poppins;
      }
    </style>
  </head>
  <body class="min-h-screen bg-cover bg-center" style="background-image: url('/images/bg-plant.jpg');">
    <div class="min-h-screen w-full bg-white/80 backdrop-blur-sm flex items-center justify-center p-6">
      <div class="max-w-7xl w-full flex flex-col md:flex-row items-center md:items-start justify-center gap-12 py-8">
        <!-- Left Section -->
        <div class="flex flex-col max-w-xl w-full md:w-1/2 text-center md:text-left">
          <div class="flex justify-center md:justify-start mb-6">
            <img alt="BPMA Logo" src="/logoBPMA.png" width="160" class="mb-6" />
          </div>
          <h1 class="text-4xl font-extrabold leading-tight text-[#1e3a8a] mb-4">
            GateLog BPMA<br/>Sistem Registrasi Tamu
          </h1>
          <p class="text-base text-slate-600 leading-relaxed max-w-md mx-auto md:mx-0">
            GateLog BPMA adalah sistem logbook digital yang dirancang untuk mencatat setiap kunjungan tamu ke lingkungan kantor Badan Pengelola Migas Aceh (BPMA).
          </p>
        </div>

        <!-- Form Section -->
        <form id="visitorForm" class="bg-white rounded-2xl shadow-2xl border border-slate-100 p-8 w-full max-w-md space-y-4" onsubmit="return submitForm(event)">
          <h2 class="text-xl font-bold text-[#1e3a8a] pb-2 border-b border-slate-100">Formulir Kunjungan</h2>
          
          <div>
            <label for="nama" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Nama Tamu</label>
            <input id="nama" name="nama" type="text" placeholder="Cth : Agus" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Nama tamu wajib diisi!')" oninput="this.setCustomValidity('')" />
          </div>

          <div>
            <label for="nik" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">NIK Tamu</label>
            <input id="nik" name="nik" type="text" placeholder="Cth: 1234567890123456" maxlength="16" minlength="16" required class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" oninvalid="this.setCustomValidity('NIK tamu wajib diisi dengan 16 digit angka!')" oninput="this.setCustomValidity('')" />
            <small class="text-red-500 text-xs mt-1 hidden" id="nikError">NIK harus terdiri dari 16 digit angka.</small>
          </div>

          <div>
            <label for="email" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Email Tamu</label>
            <input id="email" name="email" type="email" placeholder="Cth : agus@gmail.com" required class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" oninvalid="this.setCustomValidity('Format email wajib diisi dengan benar!')" oninput="this.setCustomValidity('')" />
            <small class="text-red-500 text-xs mt-1 hidden" id="emailError">Format email harus valid.</small>
          </div>

          <div>
            <label for="nomorHp" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Nomor HP Tamu</label>
            <input id="nomorHp" name="nomorHp" type="tel" placeholder="Cth: 081234567890" required class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" oninvalid="this.setCustomValidity('Nomor HP wajib diisi!')" oninput="this.setCustomValidity('')" />
            <small class="text-red-500 text-xs mt-1 hidden" id="phoneError">Nomor HP harus terdiri dari 10-14 digit angka.</small>
          </div>

          <div>
            <label for="instansi" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Asal Instansi</label>
            <input list="instansiList" id="instansi" name="instansi" type="text" placeholder="Cth: PT Pertamina, Universitas Syiah Kuala, BPMA" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Asal instansi wajib diisi!')" oninput="this.setCustomValidity('')" />
            <datalist id="instansiList">
              <option value="PT Pertamina"></option>
              <option value="PT Medco E&P"></option>
              <option value="Universitas Syiah Kuala"></option>
              <option value="BPMA (Badan Pengelola Migas Aceh)"></option>
              <option value="Pemerintah Aceh"></option>
              <option value="Kementerian ESDM"></option>
              <option value="SKK Migas"></option>
              <option value="Swasta"></option>
              <option value="Lainnya"></option>
            </datalist>
          </div>

          <div>
            <label for="bertemu" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Pegawai yang ingin ditemui</label>
            <select id="bertemu" name="bertemu" class="w-full rounded-lg text-sm px-3.5 py-2.5 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Pegawai yang ingin ditemui wajib dipilih!')" onchange="this.setCustomValidity('')">
              <option disabled selected value="">Pilih Pegawai</option>
              <% employees.forEach(emp => { %>
                <option value="<%= emp.name %> - <%= emp.position %>"><%= emp.name %> - <%= emp.position %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="janji" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Apakah sudah membuat janji?</label>
            <select id="janji" name="janji" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Pilihan ini wajib diisi!')" onchange="this.setCustomValidity('')">
              <option disabled selected value="">Pilih Jawaban</option>
              <option value="ya">Ya</option>
              <option value="tidak">Tidak</option>
            </select>
          </div>

          <div>
            <label for="keperluan" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Keperluan</label>
            <input id="keperluan" name="keperluan" type="text" placeholder="Cth: Koordinasi terkait pekerjaan" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Keperluan wajib diisi!')" oninput="this.setCustomValidity('')" />
          </div>

          <div>
            <label for="jenisKunjungan" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Jenis Kunjungan</label>
            <select id="jenisKunjungan" name="jenisKunjungan" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Jenis kunjungan wajib dipilih!')" onchange="this.setCustomValidity('')">
              <option disabled selected value="">Pilih Jenis Kunjungan</option>
              <option value="Meeting">Meeting</option>
              <option value="Konsultasi">Konsultasi</option>
              <option value="Vendor">Vendor</option>
              <option value="Pengiriman Dokumen">Pengiriman Dokumen</option>
              <option value="Interview">Interview</option>
              <option value="Maintenance">Maintenance</option>
              <option value="Audit">Audit</option>
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>

          <div>
            <label class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-2">Prioritas Kunjungan</label>
            <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-lg border border-slate-200">
              <label class="inline-flex items-center cursor-pointer">
                <input type="radio" name="prioritas" value="Normal" checked class="form-radio text-[#5ca82f] focus:ring-[#5ca82f] w-4 h-4" />
                <span class="ml-1 text-xs font-semibold text-slate-700">🟢 Normal</span>
              </label>
              <label class="inline-flex items-center cursor-pointer">
                <input type="radio" name="prioritas" value="Penting" class="form-radio text-amber-500 focus:ring-amber-500 w-4 h-4" />
                <span class="ml-1 text-xs font-semibold text-slate-700">🟡 Penting</span>
              </label>
              <label class="inline-flex items-center cursor-pointer">
                <input type="radio" name="prioritas" value="Mendesak" class="form-radio text-rose-600 focus:ring-rose-500 w-4 h-4" />
                <span class="ml-1 text-xs font-semibold text-slate-700">🔴 Mendesak</span>
              </label>
            </div>
          </div>

          <div>
            <label for="rekan" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Jumlah Tamu</label>
            <select id="rekan" name="rekan" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Jumlah tamu wajib dipilih!')" onchange="this.setCustomValidity('')">
              <option disabled selected value="">Pilih Jumlah Tamu</option>
              <option value="0">0 (Sendiri)</option>
              <option value="1">1 Orang</option>
              <option value="2">2 Orang</option>
              <option value="3">3 Orang</option>
              <option value="4">4 Orang</option>
              <option value="5+">5+ Orang</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="tanggal" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Tanggal</label>
              <input id="tanggal" name="tanggal" type="date" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Tanggal kunjungan wajib diisi!')" oninput="this.setCustomValidity('')" />
            </div>
            <div>
              <label for="jam" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Jam</label>
              <input id="jam" name="jam" type="time" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required oninvalid="this.setCustomValidity('Jam kunjungan wajib diisi!')" oninput="this.setCustomValidity('')" />
            </div>
          </div>

          <button type="submit" class="w-full bg-[#5ca82f] hover:bg-[#4d8b26] text-white font-bold text-sm py-3 rounded-lg shadow-md hover:shadow-lg transition-all mt-4">
            Kirim Registrasi
          </button>
        </form>
      </div>
    </div>

    <script>
      async function submitForm(event) {
        event.preventDefault();

        // Validasi manual NIK, Email, & Nomor HP
        const nikInput = document.getElementById('nik');
        const emailInput = document.getElementById('email');
        const nomorHpInput = document.getElementById('nomorHp');
        const nikError = document.getElementById('nikError');
        const emailError = document.getElementById('emailError');
        const phoneError = document.getElementById('phoneError');

        let isValid = true;
        nikError.classList.add('hidden');
        emailError.classList.add('hidden');
        phoneError.classList.add('hidden');

        const nik = nikInput.value.trim();
        if (!/^\d{16}$/.test(nik)) {
          nikError.classList.remove('hidden');
          isValid = false;
        }

        const email = emailInput.value.trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          emailError.classList.remove('hidden');
          isValid = false;
        }

        const nomorHp = nomorHpInput.value.trim();
        if (!/^\d{10,14}$/.test(nomorHp)) {
          phoneError.classList.remove('hidden');
          isValid = false;
        }

        if (!isValid) return false;

        const form = document.getElementById('visitorForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
          const response = await fetch('/visitor', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          if (response.ok) {
            let result = {};
            try {
              const contentType = response.headers.get('content-type');
              if (contentType && contentType.includes('application/json')) {
                result = await response.json();
              } else {
                await response.text();
              }
            } catch {}

            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: result.message || 'Data berhasil dikirim!',
              confirmButtonColor: '#5ca82f'
            }).then(() => {
              form.reset();
              const today = new Date().toISOString().split('T')[0];
              document.getElementById('tanggal').value = today;
            });
          } else {
            let errorMessage = 'Terjadi kesalahan saat mengirim data.';
            try {
              const contentType = response.headers.get('content-type');
              if (contentType && contentType.includes('application/json')) {
                const errorResult = await response.json();
                errorMessage = errorResult.message || errorMessage;
              }
            } catch {}
            Swal.fire({ icon: 'error', title: 'Gagal!', text: errorMessage });
          }
        } catch (err) {
          Swal.fire({
            icon: 'error',
            title: 'Network Error!',
            text: 'Gagal mengirim data. Periksa koneksi internet atau coba lagi nanti.',
          });
        }

        return false;
      }

      document.addEventListener('DOMContentLoaded', function () {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('tanggal').value = today;
      });
    </script>
  </body>
</html>
