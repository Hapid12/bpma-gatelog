<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Visitor - BPMA GateLog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-4 text-center">Form Data Visitor</h1>

    <!-- Form -->
    <div class="card mb-5 shadow-sm">
      <div class="card-body">
        <form method="POST" action="/visitor/add">
          <div class="mb-3">
            <label class="form-label">Nama</label>
            <input type="text" name="name" class="form-control" placeholder="Masukkan nama visitor" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" placeholder="Alamat email visitor" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Instansi Asal</label>
            <input type="text" name="institution" class="form-control" placeholder="Instansi/Perusahaan asal" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Ingin Bertemu Siapa?</label>
            <input type="text" name="targetEmployee" class="form-control" placeholder="Nama karyawan yang ingin ditemui" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Sudah Membuat Janji?</label>
            <select class="form-select" name="hasAppointment" required>
              <option value="">-- Pilih --</option>
              <option value="Ya">Ya</option>
              <option value="Tidak">Tidak</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Keperluan</label>
            <input type="text" name="purpose" class="form-control" placeholder="Keperluan kunjungan" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Jumlah Rekan yang Bersama Anda</label>
            <input type="number" name="companions" class="form-control" min="0" placeholder="Jumlah orang bersama Anda" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Jadwal Pertemuan</label>
            <input type="datetime-local" name="schedule" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary">Simpan Data</button>
        </form>
      </div>
    </div>

<!-- Tabel Histori Visitor -->
<h2 class="mb-3">Histori Visitor</h2>
<div class="table-responsive shadow-sm">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>No</th>
        <th>Nama</th>
        <th>Email</th>
        <th>Instansi</th>
        <th>Ingin Bertemu</th>
        <th>Janji?</th>
        <th>Keperluan</th>
        <th>Jumlah Rekan</th>
        <th>Jadwal</th>
        <th>Tanggal Kunjungan</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% if (visitors.length === 0) { %>
        <tr>
          <td colspan="11" class="text-center">Belum ada data.</td>
        </tr>
      <% } else { %>
        <% visitors.forEach((visitor, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= visitor.name %></td>
            <td><%= visitor.email %></td>
            <td><%= visitor.institution %></td>
            <td><%= visitor.targetEmployee %></td>
            <td><%= visitor.hasAppointment %></td>
            <td><%= visitor.purpose %></td>
            <td><%= visitor.companions %></td>
            <td><%= new Date(visitor.schedule).toLocaleString("id-ID") %></td>
            <td><%= new Date(visitor.date).toLocaleString("id-ID") %></td>
            <td>
              <a href="/visitor/edit/<%= visitor._id %>" class="btn btn-sm btn-warning">Edit</a>
              <form action="/visitor/delete/<%= visitor._id %>" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Hapus data ini?')">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
  </div>
</body>
</html>
