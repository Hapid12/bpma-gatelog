<%- include('partials/header', { currentPath: request.url }) %>


<!DOCTYPE html>
<html lang="en">
 <head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1" name="viewport"/>
  <title>
   Gate Log
  </title>
  <script src="https://cdn.tailwindcss.com">
  </script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter&amp;display=swap" rel="stylesheet"/>
  <style>
   body {
      font-family: 'Inter', sans-serif;
    }
  </style>
 </head>
 <body class="min-h-screen bg-black relative">
  <img alt="Aerial view of an industrial plant with pipes and structures under a partly cloudy sky" class="absolute inset-0 w-full h-full object-cover brightness-50" height="1080" src="https://storage.googleapis.com/a1aa/image/a17ac5d8-8b3f-4f30-a964-9f476c016760.jpg" width="1920"/>
  <header class="fixed top-0 left-0 right-0 z-10 flex items-center gap-2 bg-black bg-opacity-90 px-4 py-3 rounded-b-2xl">
   <a class="navbar-brand d-flex align-items-center" href="/">
       <img src="/logoBPMA.png" alt="BPMA" width="116" height="85" class="me-2">   
    </a>
   <h1 class="flex-1 text-center text-white font-bold text-2xl select-none">
    GATE - LOG
</h1>
  </header>
  <main class="relative z-10 max-w-3xl mx-auto pt-20 mt-8 bg-black bg-opacity-70 rounded-xl p-8">
   <form class="space-y-4">
    <div class="-mt-11">
     <label class="block text-white text-xs font-semibold mb-2" for="nama">
      Nama:
     </label>
     <input class="w-full rounded-md text-xs px-3 py-2 border border-transparent focus:outline-none focus:ring-2 focus:ring-blue-600" id="nama" placeholder="Cth : Agus" type="text"/>
    </div>
    <div class="mt-6">
     <label class="block text-white text-xs font-semibold mb-2" for="email">
      Email:
     </label>
     <input class="w-full rounded-md text-xs px-3 py-2 border border-transparent focus:outline-none focus:ring-2 focus:ring-blue-600" id="email" placeholder="Cth : Agus123@gmail.com" type="email"/>
    </div>
    <div class="mt-6">
     <label class="block text-white text-xs font-semibold mb-2" for="instansi">
      Instansi Asal:
     </label>
     <select class="w-44 rounded-md text-xs px-3 py-2 border border-transparent bg-white text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-600" id="instansi">
      <option disabled="" selected="">
       Select your answer
      </option>
     </select>
    </div>
    <div class="mt-6">
     <label class="block text-white text-xs font-semibold mb-2" for="bertemu">
      Ingin Bertemu dengan:
     </label>
     <select class="w-44 rounded-md text-xs px-3 py-2 border border-transparent bg-white text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-600" id="bertemu">
      <option disabled="" selected="">
       Select your answer
      </option>
     </select>
    </div>
    <div class="mt-6">
     <label class="block text-white text-xs font-semibold mb-2" for="janji">
      Apakah sudah membuat janji?
     </label>
     <select class="w-44 rounded-md text-xs px-3 py-2 border border-transparent bg-white text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-600" id="janji">
      <option disabled="" selected="">
       Select your answer
      </option>
     </select>
    </div>
    <div class="mt-6">
     <label class="block text-white text-xs font-semibold mb-2" for="keperluan">
      Keperluan:
     </label>
     <input class="w-full rounded-md text-xs px-3 py-2 border border-transparent focus:outline-none focus:ring-2 focus:ring-blue-600" id="keperluan" placeholder="Cth : Saya ingin bertemu dengan ... dengan keperluan ..." type="text"/>
    </div>
    <div class="mt-6">
     <label class="block text-white text-xs font-semibold mb-2" for="rekan">
      Jumlah rekan yang bersama anda:
     </label>
     <select class="w-44 rounded-md text-xs px-3 py-2 border border-transparent bg-white text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-600" id="rekan">
      <option disabled="" selected="">
       Select your answer
      </option>
     </select>
    </div>
    <div class="mt-6">
     <label class="block text-white text-xs font-semibold mb-2" for="tanggal">
      Tanggal kunjungan:
     </label>
     <select class="w-44 rounded-md text-xs px-3 py-2 border border-transparent bg-white text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-600" id="tanggal">
      <option disabled="" selected="">
       Select your answer
      </option>
     </select>
    </div>
    <button class="mt-8 px-4 py-2 text-xs font-semibold text-white bg-blue-600 rounded hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600" type="submit">
     Kirim
    </button>
   </form>
  </main>
 </body>
</html>
