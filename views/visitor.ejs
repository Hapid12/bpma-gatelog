<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>GateLog BPMA Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter&display=swap');
      body {
        font-family: 'Inter', Poppins;
      }
    </style>
  </head>
  <body class="min-h-screen bg-cover bg-center" style="background-image: url('/images/bg-plant.jpg');">
    <div class="min-h-screen w-full bg-black/50 flex items-center justify-center p-6">
      >
      <div class="max-w-7xl w-full flex flex-col md:flex-row items-center md:items-start justify-center gap-12">
      <!-- Left Section -->
      <div class="flex flex-col max-w-xl w-full md:w-1/2 text-center md:text-left text-white">
        <div class="flex justify-center md:justify-start mb-6">
          <img alt="BPMA Logo" src="/logoBPMA.png" width="150" class="mb-18" />
        </div>
        <h1 class="text-4xl font-extrabold leading-tight mb-3">
          GateLog BPMA<br/>Sistem Registrasi Tamu
        </h1>
        <p class="text-sm text-white /90 max-w-md mx-auto md:mx-0 ">
          GateLog BPMA adalah sistem logbook digital yang dirancang untuk mencatat setiap kunjungan tamu ke lingkungan kantor Badan Pengelola Migas Aceh (BPMA).
        </p>
      </div>

      <!-- Form Section -->
      <form id="visitorForm" class="bg-[#3a3a3a] rounded-lg p-6 w-full max-w-md space-y-4" onsubmit="return submitForm(event)">
        <div>
          <label for="nama" class="block text-white font-medium text-sm mb-1">Nama Tamu:</label>
          <input id="nama" name="nama" type="text" placeholder="Cth : Agus" class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" required />
        </div>

        <div>
    <label for="nik" class="block text-white font-medium text-sm mb-1">NIK Tamu:</label>
    <input id="nik" name="nik" type="text" placeholder="Cth: 1234567890123456"
      maxlength="16" minlength="16" required
      class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" />
    <small class="text-red-500 text-xs" id="nikError">NIK harus terdiri dari 16 digit angka.</small>
      </div>

        <div>
          <label for="email" class="block text-white font-medium text-sm mb-1">Email Tamu:</label>
          <input id="email" name="email" type="email" placeholder="Cth : agus@gmail.com"
            required class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" />
          <small class="text-red-500 text-xs" id="emailError">Format email harus valid.</small>
        </div>

        <div>
          <label for="instansi" class="block text-white font-medium text-sm mb-1">Asal Instansi:</label>
          <select id="instansi" name="instansi" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none">
            <option disabled selected>Select your answer</option>
            <option value="pemerintah">Pemerintah</option>
            <option value="swasta">Swasta</option>
            <option value="universitas">Universitas</option>
            <option value="lainnya">Lainnya</option>
          </select>
        </div>

        <div>
          <label for="bertemu" class="block text-white font-medium text-sm mb-1">Pegawai yang ingin ditemui:</label>
          <input list="employeeList" id="bertemu" name="bertemu"
                placeholder="Ketik minimal 3 huruf nama pegawai..."
                class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 bg-white text-black focus:outline-none" required />
          <datalist id="employeeList">
            <% employees.forEach(emp => { %>
              <option value="<%= emp.name %> - <%= emp.position %>"></option>
            <% }) %>
          </datalist>
        </div>

        <div>
          <label for="janji" class="block text-white font-medium text-sm mb-1">Apakah sudah membuat janji?</label>
          <select id="janji" name="janji" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required>
            <option disabled selected>Select your answer</option>
            <option value="ya">Ya</option>
            <option value="tidak">Tidak</option>
          </select>
        </div>

        <div>
          <label for="keperluan" class="block text-white font-medium text-sm mb-1">Keperluan:</label>
          <input id="keperluan" name="keperluan" type="text" placeholder="Cth: Saya ingin bertemu dengan ..." class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" required />
        </div>

        <div>
          <label for="rekan" class="block text-white font-medium text-sm mb-1">Jumlah Tamu:</label>
          <select id="rekan" name="rekan" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none">
            <option disabled selected>Select your answer</option>
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5+">5+</option>
          </select>
        </div>

        <div>
          <label for="tanggal" class="block text-white font-medium text-sm mb-1">Tanggal Kunjungan:</label>
          <input id="tanggal" name="tanggal" type="date" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required />
        </div>

        <div class="mt-3">
          <label for="jam" class="block text-white font-medium text-sm mb-1">Jam Kunjungan:</label>
          <input id="jam" name="jam" type="time" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required />
        </div>

        <button type="submit" class="w-full bg-[#5ca82f] text-white font-semibold text-xs py-2 rounded mt-4">
          Kirim
        </button>
      </form>
    </div>

    <script>
      async function submitForm(event) {
        event.preventDefault();

        // Validasi manual NIK & Email
        const nikInput = document.getElementById('nik');
        const emailInput = document.getElementById('email');
        const nikError = document.getElementById('nikError');
        const emailError = document.getElementById('emailError');

        let isValid = true;
        nikError.classList.add('hidden');
        emailError.classList.add('hidden');

        const nik = nikInput.value.trim();
        if (!/^\d{16}$/.test(nik)) {
          nikError.classList.remove('hidden');
          isValid = false;
        }

        const email = emailInput.value.trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          emailError.classList.remove('hidden');
          isValid = false;
        }

        if (!isValid) return false;

        const form = document.getElementById('visitorForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
          const response = await fetch('/visitor', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          if (response.ok) {
            let result = {};
            try {
              const contentType = response.headers.get('content-type');
              if (contentType && contentType.includes('application/json')) {
                result = await response.json();
              } else {
                await response.text();
              }
            } catch {}

            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: result.message || 'Data berhasil dikirim!',
              confirmButtonColor: '#5ca82f'
            }).then(() => {
              form.reset();
              const today = new Date().toISOString().split('T')[0];
              document.getElementById('tanggal').value = today;
            });
          } else {
            let errorMessage = 'Terjadi kesalahan saat mengirim data.';
            try {
              const contentType = response.headers.get('content-type');
              if (contentType && contentType.includes('application/json')) {
                const errorResult = await response.json();
                errorMessage = errorResult.message || errorMessage;
              }
            } catch {}
            Swal.fire({ icon: 'error', title: 'Gagal!', text: errorMessage });
          }
        } catch (err) {
          Swal.fire({
            icon: 'error',
            title: 'Network Error!',
            text: 'Gagal mengirim data. Periksa koneksi internet atau coba lagi nanti.',
          });
        }

        return false;
      }

      document.addEventListener('DOMContentLoaded', function () {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('tanggal').value = today;
      });
    </script>
  </body>
</html>
