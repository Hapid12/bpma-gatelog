<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>GateLog BPMA Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter&display=swap');
      body {
        font-family: 'Inter', sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#f7f8f8] min-h-screen flex items-center justify-center p-6">
    <div class="max-w-7xl w-full flex flex-col md:flex-row items-center md:items-start justify-center gap-12">
      
      <!-- Left Section (Informasi) -->
      <div class="flex flex-col max-w-xl w-full md:w-1/2">
        <img alt="BPMA Logo" src="/logoBPMA.png" width="100" class="mb-6" />
        <h1 class="text-3xl font-extrabold leading-tight mb-4">
          GateLog BPMA<br/>Sistem Registrasi Tamu
        </h1>
        <p class="text-sm text-black/90 max-w-md">
          GateLog BPMA adalah sistem logbook digital yang dirancang untuk mencatat setiap kunjungan tamu ke lingkungan kantor Badan Pengelola Migas Aceh (BPMA).
        </p>
      </div>

      <!-- Form Section -->
      <form action="/visitor" method="POST" class="bg-[#3a3a3a] rounded-lg p-6 w-full max-w-md space-y-4">
        <div>
          <label for="nama" class="block text-white font-semibold text-sm mb-1">Nama:</label>
          <input id="nama" name="nama" type="text" placeholder="Cth : Agus" class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" />
        </div>

        <div>
          <label for="email" class="block text-white font-semibold text-sm mb-1">Email:</label>
          <input id="email" name="email" type="email" placeholder="Cth : agus@gmail.com" class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" />
        </div>

        <div>
          <label for="instansi" class="block text-white font-semibold text-sm mb-1">Instansi Asal:</label>
          <select id="instansi" name="instansi" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none">
            <option disabled selected>Select your answer</option>
            <option value="pemerintah">Pemerintah</option>
            <option value="swasta">Swasta</option>
            <option value="universitas">Universitas</option>
            <option value="lainnya">Lainnya</option>
          </select>
        </div>

        <div>
          <label for="bertemu" class="block text-white font-semibold text-sm mb-1">Ingin bertemu dengan:</label>
          <select id="bertemu" name="bertemu" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none">
            <option disabled selected>Select your answer</option>
            <% employees.forEach(emp => { %>
              <option value="<%= emp.name %>" data-email="<%= emp.email %>"><%= emp.name %> - <%= emp.email %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="janji" class="block text-white font-semibold text-sm mb-1">Apakah sudah membuat janji?</label>
          <select id="janji" name="janji" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none">
            <option disabled selected>Select your answer</option>
            <option value="ya">Ya</option>
            <option value="tidak">Tidak</option>
          </select>
        </div>

        <div>
          <label for="keperluan" class="block text-white font-semibold text-sm mb-1">Keperluan:</label>
          <input id="keperluan" name="keperluan" type="text" placeholder="Cth: Saya ingin bertemu dengan ..." class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" />
        </div>

        <div>
          <label for="rekan" class="block text-white font-semibold text-sm mb-1">Jumlah rekan:</label>
          <select id="rekan" name="rekan" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none">
            <option disabled selected>Select your answer</option>
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5+">5+</option>
          </select>
        </div>

        <div>
          <label for="tanggal" class="block text-white font-semibold text-sm mb-1">Tanggal Kunjungan:</label>
          <input id="tanggal" name="tanggal" type="date" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" />
        </div>

        <button type="submit" class="w-full bg-[#5ca82f] text-white font-semibold text-xs py-2 rounded">
          Kirim
        </button>
      </form>
    </div>
  </body>
</html>
