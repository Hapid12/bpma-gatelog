<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>GateLog BPMA Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter&display=swap');
      body {
        font-family: 'Inter', Poppins;
      }
    </style>
  </head>
  <body class="bg-[#f7f8f8] min-h-screen flex items-center justify-center p-6">
    <div class="max-w-7xl w-full flex flex-col md:flex-row items-center md:items-start justify-center gap-12">

      <!-- Left Section -->
      <div class="flex flex-col max-w-xl w-full md:w-1/2 text-center md:text-left">
        <div class="flex justify-center md:justify-start mb-6">
          <img alt="BPMA Logo" src="/logoBPMA.png" width="165" class="mb-28" />
        </div>
        <h1 class="text-4xl font-extrabold leading-tight mb-3">
          GateLog BPMA<br/>Sistem Registrasi Tamu
        </h1>
        <p class="text-sm text-black/90 max-w-md mx-auto md:mx-0">
          GateLog BPMA adalah sistem logbook digital yang dirancang untuk mencatat setiap kunjungan tamu ke lingkungan kantor Badan Pengelola Migas Aceh (BPMA).
        </p>
      </div>

      <!-- Form Section -->
      <form id="visitorForm" class="bg-[#3a3a3a] rounded-lg p-6 w-full max-w-md space-y-4" onsubmit="return submitForm(event)">
        <div>
          <label for="nama" class="block text-white font-medium text-sm mb-1">Nama:</label>
          <input id="nama" name="nama" type="text" placeholder="Cth : Agus" class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" required />
        </div>

        <div>
          <label for="nik" class="block text-white font-medium text-sm mb-1">NIK:</label>
          <input id="nik" name="nik" type="text" placeholder="Cth: 1234567890123456" class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" />
        </div>

        <div>
          <label for="email" class="block text-white font-medium text-sm mb-1">Email:</label>
          <input id="email" name="email" type="email" placeholder="Cth : agus@gmail.com" class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" required />
        </div>

        <div>
          <label for="instansi" class="block text-white font-medium text-sm mb-1">Instansi Asal:</label>
          <select id="instansi" name="instansi" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required>
            <option disabled selected>Select your answer</option>
            <option value="pemerintah">Pemerintah</option>
            <option value="swasta">Swasta</option>
            <option value="universitas">Universitas</option>
            <option value="lainnya">Lainnya</option>
          </select>
        </div>

        <div>
          <label for="bertemu" class="block text-white font-medium text-sm mb-1">Ingin bertemu dengan:</label>
          <select id="bertemu" name="bertemu" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required>
            <option disabled selected>Select your answer</option>
            <% employees.forEach(emp => { %>
              <option value="<%= emp.name %>" data-email="<%= emp.email %>"><%= emp.name %> - <%= emp.email %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label for="janji" class="block text-white font-medium text-sm mb-1">Apakah sudah membuat janji?</label>
          <select id="janji" name="janji" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required>
            <option disabled selected>Select your answer</option>
            <option value="ya">Ya</option>
            <option value="tidak">Tidak</option>
          </select>
        </div>

        <div>
          <label for="keperluan" class="block text-white font-medium text-sm mb-1">Keperluan:</label>
          <input id="keperluan" name="keperluan" type="text" placeholder="Cth: Saya ingin bertemu dengan ..." class="w-full rounded text-xs px-3 py-2 placeholder:text-gray-400 focus:outline-none" required />
        </div>

        <div>
          <label for="rekan" class="block text-white font-medium text-sm mb-1">Jumlah rekan:</label>
          <select id="rekan" name="rekan" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required>
            <option disabled selected>Select your answer</option>
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5+">5+</option>
          </select>
        </div>

        <div>
          <label for="tanggal" class="block text-white font-medium text-sm mb-1">Tanggal Kunjungan:</label>
          <input id="tanggal" name="tanggal" type="date" class="w-full rounded text-xs px-3 py-2 bg-white text-black focus:outline-none" required />
        </div>

        <button type="submit" class="w-full bg-[#5ca82f] text-white font-semibold text-xs py-2 rounded">
          Kirim
        </button>
      </form>
    </div>

    <script>
      async function submitForm(event) {
        event.preventDefault();

        const form = document.getElementById('visitorForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
          console.log('Sending data:', data);

          const response = await fetch('/visitor', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          console.log('Response status:', response.status);
          console.log('Response ok:', response.ok);

          // Jika response berhasil (status 200-299), anggap data berhasil disimpan
          if (response.ok) {
            // Coba parse JSON, tapi jika gagal tidak masalah
            let result = {};
            try {
              const contentType = response.headers.get('content-type');
              if (contentType && contentType.includes('application/json')) {
                result = await response.json();
                console.log('Response data:', result);
              } else {
                // Jika bukan JSON, baca sebagai text untuk debug
                const textResponse = await response.text();
                console.log('Response text:', textResponse);
              }
            } catch (parseError) {
              console.log('JSON parse error (but request was successful):', parseError);
            }

            // Tampilkan success message
            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: result.message || 'Data berhasil dikirim!',
              confirmButtonColor: '#5ca82f'
            }).then(() => {
              form.reset();
              // Set tanggal kembali ke hari ini setelah reset
              const today = new Date().toISOString().split('T')[0];
              document.getElementById('tanggal').value = today;
            });
          } else {
            // Jika status bukan 2xx, coba baca error message
            let errorMessage = 'Terjadi kesalahan saat mengirim data.';
            try {
              const contentType = response.headers.get('content-type');
              if (contentType && contentType.includes('application/json')) {
                const errorResult = await response.json();
                errorMessage = errorResult.message || errorMessage;
              } else {
                const textError = await response.text();
                console.error('Error response text:', textError);
              }
            } catch (parseError) {
              console.error('Error parsing error response:', parseError);
            }

            Swal.fire({
              icon: 'error',
              title: 'Gagal!',
              text: errorMessage,
            });
          }
        } catch (err) {
          console.error('Network error:', err);
          Swal.fire({
            icon: 'error',
            title: 'Network Error!',
            text: 'Gagal mengirim data. Periksa koneksi internet atau coba lagi nanti.',
          });
        }

        return false;
      }

      // Set tanggal default ke hari ini
      document.addEventListener('DOMContentLoaded', function() {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('tanggal').value = today;
      });
    </script>
  </body>
</html>