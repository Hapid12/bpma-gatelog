

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Visitor - BPMA GateLog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">

</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-4 text-center">Form Data Visitor</h1>

    <!-- Form -->
    <div class="card mb-5 shadow-sm">
      <div class="card-body">
        <form method="POST" action="/visitor/add">
          <div class="mb-3">
            <label class="form-label">Nama</label>
            <input type="text" name="name" class="form-control" placeholder="Masukkan nama visitor" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Keperluan</label>
            <input type="text" name="purpose" class="form-control" placeholder="Masukkan keperluan" required>
          </div>
          <button type="submit" class="btn btn-primary">Simpan Data</button>
        </form>
      </div>
    </div>

    <!-- Tabel Histori Visitor -->
    <h2 class="mb-3">Histori Visitor</h2>
    <div class="table-responsive shadow-sm">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>No</th>
            <th>Nama</th>
            <th>Keperluan</th>
            <th>Tanggal</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (visitors.length === 0) { %>
            <tr>
              <td colspan="5" class="text-center">Belum ada data.</td>
            </tr>
          <% } else { %>
            <% visitors.forEach((visitor, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= visitor.name %></td>
                <td><%= visitor.purpose %></td>
                <td><%= new Date(visitor.date).toLocaleDateString("id-ID") %></td>
                <td>
                  <a href="/visitor/edit/<%= visitor._id %>" class="btn btn-sm btn-warning">Edit</a>
                  <form action="/visitor/delete/<%= visitor._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Hapus data ini?')">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
<%- include('partials/footer') %>
</html>
