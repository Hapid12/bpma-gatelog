<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - BPMA GateLog</title>
  
  <!-- Imports -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
        }
      }
    }
  </script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex items-center justify-center p-4 antialiased font-sans relative overflow-hidden">
  
  <!-- Efek Cahaya Latar Belakang (Glowing Circles) -->
  <div class="absolute w-96 h-96 bg-[#1e3a8a]/10 rounded-full blur-[100px] -top-20 -left-20 z-0"></div>
  <div class="absolute w-96 h-96 bg-[#5ca82f]/10 rounded-full blur-[100px] -bottom-20 -right-20 z-0"></div>

  <!-- Kartu Form Login -->
  <div class="max-w-md w-full bg-white backdrop-blur-xl border border-slate-200 rounded-2xl p-8 shadow-2xl relative z-10">
    
    <!-- Logo & Judul -->
    <div class="flex flex-col items-center mb-8">
      <div class="flex items-center justify-center bg-[#1e3a8a] p-3 rounded-2xl border border-[#1e3a8a]/80 mb-3.5 shadow-md">
        <svg class="w-12 h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 3C12 3 6 8.5 6 13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13C18 8.5 12 3 12 3Z" fill="url(#leafGradient)"/>
          <path d="M12 8C12 8 9.5 11 9.5 13C9.5 14.3807 10.6193 15.5 12 15.5C13.3807 15.5 14.5 14.3807 14.5 13C14.5 11 12 8 12 8Z" fill="#FFFFFF"/>
          <defs>
            <linearGradient id="leafGradient" x1="6" y1="3" x2="18" y2="19" gradientUnits="userSpaceOnUse">
              <stop stop-color="#10B981"/>
              <stop stop-color="#059669"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <h2 class="text-xl font-bold tracking-wider text-slate-800">BPMA <span class="text-[#5ca82f] font-semibold">GateLog</span></h2>
      <p class="text-xs text-slate-500 mt-1">Sistem Manajemen Akses Terintegrasi</p>
    </div>

    <!-- Alert Pesan Error / Sukses -->
    <% if (error && error.length > 0) { %>
      <div class="mb-5 bg-rose-500/10 border border-rose-500/25 text-rose-400 text-xs px-4 py-2.5 rounded-lg flex items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill text-sm"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (success && success.length > 0) { %>
      <div class="mb-5 bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs px-4 py-2.5 rounded-lg flex items-center gap-2">
        <i class="bi bi-check-circle-fill text-sm"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- Form Login -->
    <form action="/login" method="POST" class="space-y-5">
      <div>
        <label for="username" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Username</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            <i class="bi bi-person"></i>
          </span>
          <input type="text" name="username" id="username" required 
            class="w-full bg-slate-50 border border-slate-300 focus:border-[#5ca82f] focus:ring-1 focus:ring-[#5ca82f] rounded-lg pl-10 pr-4 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none transition-colors duration-200"
            placeholder="Masukkan username Anda...">
        </div>
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Password</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            <i class="bi bi-lock"></i>
          </span>
          <input type="password" name="password" id="password" required 
            class="w-full bg-slate-50 border border-slate-300 focus:border-[#5ca82f] focus:ring-1 focus:ring-[#5ca82f] rounded-lg pl-10 pr-4 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none transition-colors duration-200"
            placeholder="Masukkan password Anda...">
        </div>
      </div>

      <button type="submit" 
        class="w-full bg-[#5ca82f] hover:bg-[#4a8a24] text-white font-semibold py-2.5 rounded-lg text-xs tracking-wider uppercase transition-colors duration-250 shadow-lg shadow-[#5ca82f]/20 mt-2 focus:outline-none">
        Masuk Aplikasi
      </button>
    </form>

    <!-- Footer Hak Cipta -->
    <div class="text-center mt-8 text-[10px] text-slate-500">
      © 2026 BPMA GateLog - Badan Pengelola Migas Aceh
    </div>

  </div>

</body>
</html>
