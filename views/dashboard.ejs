<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - BPMA GateLog</title>

  <!-- ================= IMPORT FONTS & LIBRARIES ================= -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

  <!-- ================= CONFIG TAILWIND CUSTOM FONT ================= -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
        }
      }
    }
  </script>

  <!-- ================= CUSTOM CSS OVERRIDES (DARK MODALS & SCROLLBAR) ================= -->
  <style>
    /* Desain custom scrollbar bertema gelap */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Penyesuaian tema gelap untuk Modal Bootstrap */
    .modal-content {
      background-color: #ffffff !important;
      border: 1px solid #e2e8f0 !important;
      color: #1e293b !important;
    }

    .modal-header {
      border-bottom: 1px solid #e2e8f0 !important;
    }

    .modal-footer {
      border-top: 1px solid #e2e8f0 !important;
    }

    .btn-close {
      /* normal close button */
    }

    .modal-body table th {
      background-color: #f8fafc !important;
      color: #1e293b !important;
      border-color: #e2e8f0 !important;
    }

    .modal-body table td {
      border-color: #e2e8f0 !important;
      color: #334155 !important;
    }

    .modal-body table {
      border-color: #e2e8f0 !important;
    }

    /* Sticky header untuk tabel di dalam modal */
    .sticky-table-scroll {
      max-height: 550px;
      overflow: auto;
      position: relative;
    }

    .sticky-table-scroll th {
      position: sticky;
      top: 0;
      z-index: 10;
      background-color: #f8fafc !important;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 antialiased overflow-hidden font-sans">

  <!-- ================= CONTAINER UTAMA (SIDEBAR + KONTEN) ================= -->
  <div class="flex h-screen w-screen overflow-hidden">

    <!-- ================= BAGIAN SIDEBAR NAVIGASI KIRI ================= -->
    <aside class="w-64 bg-[#1e3a8a] border-r border-[#1e3a8a]/20 flex flex-col justify-between shrink-0 z-20">
      <div>
        <!-- Logo BPMA GateLog -->
        <div class="flex items-center px-6 py-5 border-b border-[#1e3a8a]/20">
          <svg class="w-8 h-8 mr-2.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3C12 3 6 8.5 6 13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13C18 8.5 12 3 12 3Z"
              fill="url(#leafGradient)" />
            <path
              d="M12 8C12 8 9.5 11 9.5 13C9.5 14.3807 10.6193 15.5 12 15.5C13.3807 15.5 14.5 14.3807 14.5 13C14.5 11 12 8 12 8Z"
              fill="#FFFFFF" />
            <defs>
              <linearGradient id="leafGradient" x1="6" y1="3" x2="18" y2="19" gradientUnits="userSpaceOnUse">
                <stop stop-color="#10B981" />
                <stop stop-color="#059669" />
              </linearGradient>
            </defs>
          </svg>
          <div class="flex flex-col">
            <span class="text-base font-bold tracking-wider text-white">BPMA</span>
            <span class="text-xs font-semibold tracking-wide text-[#5ca82f] -mt-1">GateLog</span>
          </div>
        </div>

        <!-- Menu Navigasi Sidebar (Dinamis berdasarkan Role) -->
        <nav class="flex-1 px-4 space-y-1.5 py-6">
          <!-- Menu Dashboard (Semua Role) -->
          <a href="/"
            class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-[#5ca82f]/90 shadow-md shadow-[#5ca82f]/20 transition-all duration-200">
            <i class="bi bi-grid-fill mr-3 text-base"></i>
            <span>Dashboard</span>
          </a>

          <!-- Menu Visitor (Semua Role) -->
          <a href="/visitor"
            class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-people mr-3 text-base"></i>
            <span>Visitor</span>
          </a>

          <!-- Menu Paket Masuk (Semua Role) -->
          <a href="/package"
            class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-box-seam mr-3 text-base"></i>
            <span>Paket Masuk</span>
          </a>

          <% if (user && user.role==='admin' ) { %>
            <!-- Menu Appointment (Hanya Admin) -->
            <a href="/appointment"
              class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
              <i class="bi bi-calendar-event mr-3 text-base"></i>
              <span>Appointment</span>
            </a>
            <% } %>

              <!-- Menu Approval (Semua Role) -->
              <a href="/approval"
                class="flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
                <div class="flex items-center">
                  <i class="bi bi-shield-check mr-3 text-base"></i>
                  <span>Approval</span>
                </div>
              </a>

              <% if (user && user.role==='admin' ) { %>
                <!-- Menu Laporan (Hanya Admin) -->
                <a href="/laporan"
                  class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
                  <i class="bi bi-file-earmark-text mr-3 text-base"></i>
                  <span>Laporan</span>
                </a>

                <!-- Menu Audit Log (Hanya Admin) -->
                <a href="/audit-log"
                  class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
                  <i class="bi bi-journal-code mr-3 text-base"></i>
                  <span>Audit Log</span>
                </a>
                <% } %>

                <!-- Menu Pengaturan (Admin & Satpam) -->
                <a href="/pengaturan"
                  class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
                  <i class="bi bi-gear mr-3 text-base"></i>
                  <span>Pengaturan</span>
                </a>
        </nav>
      </div>

      <!-- Info Profil User Aktif (Bawah Sidebar) + Tombol Logout -->
      <div class="p-4 border-t border-[#1e3a8a]/20">
        <a href="/logout"
          class="flex items-center justify-between p-2 rounded-lg hover:bg-rose-950/20 group cursor-pointer transition-colors duration-200">
          <div class="flex items-center space-x-3">
            <div
              class="w-8 h-8 rounded-full bg-<%= (user && user.role === 'admin') ? 'blue' : 'emerald' %>-600 flex items-center justify-center font-bold text-white text-xs shadow-md shadow-[#5ca82f]/10">
              <%= user && user.name ? user.name[0].toUpperCase() : 'U' %>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-white">
                <%= user && user.name ? user.name : 'User' %>
              </span>
              <span class="text-[10px] text-blue-200 capitalize">Role: <%= user && user.role ? user.role : 'Guest' %>
              </span>
            </div>
          </div>
          <i class="bi bi-box-arrow-right text-blue-300 group-hover:text-rose-400 text-sm transition-colors"></i>
        </a>
      </div>
    </aside>

    <!-- ================= BAGIAN PANEL KONTEN KANAN ================= -->
    <div class="flex-1 flex flex-col overflow-hidden bg-slate-50">

      <!-- ================= BAGIAN TOPBAR (HEADER ATAS) ================= -->
      <header
        class="h-20 bg-white/90 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-8 z-10 shrink-0">
        <div>
          <h1 class="text-xl font-bold text-slate-800 tracking-wide">Dashboard</h1>
          <p class="text-[11px] text-slate-600 mt-0.5">Monitoring kunjungan dan barang masuk secara real-time</p>
        </div>

        <div class="flex items-center space-x-6">
          <!-- Kotak Pencarian Global -->
          <div class="relative w-72">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
              <i class="bi bi-search text-slate-600 text-xs"></i>
            </span>
            <input type="text" id="globalSearchInput"
              class="w-full bg-white border border-slate-200 text-xs text-slate-800 rounded-lg pl-9 pr-4 py-2 focus:outline-none focus:border-[#5ca82f] focus:ring-1 focus:ring-[#5ca82f] placeholder-slate-500"
              placeholder="Cari visitor, paket, atau karyawan...">
          </div>


          <!-- Widget Tanggal & Jam Digital -->
          <div class="flex items-center space-x-3 text-xs">
            <div
              class="flex items-center space-x-2 bg-white border border-slate-200 px-3 py-2 rounded-lg text-slate-700">
              <i class="bi bi-calendar3 text-[#5ca82f]"></i>
              <span id="current-date" class="font-medium">Minggu, 7 Juni 2026</span>
            </div>
            <div
              class="flex items-center space-x-2 bg-white border border-slate-200 px-3 py-2 rounded-lg text-slate-700">
              <i class="bi bi-clock text-[#5ca82f]"></i>
              <span id="current-time" class="font-mono font-medium">13:57:12</span>
            </div>
          </div>
        </div>
      </header>

      <!-- ================= AREA UTAMA DASHBOARD ================= -->
      <main class="flex-1 overflow-y-auto p-8 space-y-6">

        <!-- Header Aksi Ringkasan -->
        <div class="flex justify-between items-center">
          <h2 class="text-base font-semibold text-slate-600 uppercase tracking-wider">Ringkasan Aktivitas</h2>
          <button
            class="bg-[#5ca82f] hover:bg-[#4a8a24] text-white font-medium text-xs px-4 py-2 rounded-lg transition-all duration-200 shadow-lg shadow-[#5ca82f]/10 flex items-center gap-1.5"
            id="btnTambahVisitor">
            <i class="bi bi-plus-circle"></i> Tambah Data
          </button>
        </div>

        <!-- ================= BAGIAN KARTU METRIK RINGKASAN (GRID OF 4) ================= -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

          <!-- Metrik 1: Visitor Hari Ini -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 hover:border-[#5ca82f]/30 hover:shadow-lg hover:shadow-[#5ca82f]/5 transition-all duration-300 flex flex-col justify-between h-32 relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-[#5ca82f] rounded-l-xl"></div>
            <div class="flex justify-between items-start pl-2 z-10">
              <div>
                <p class="text-[10px] font-medium text-slate-600 uppercase tracking-wider">Visitor Hari Ini</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1.5 leading-none">
                  <%= visitorsToday.length %>
                </h3>
                <p class="text-[10px] font-semibold text-emerald-400 mt-2 flex items-center">
                  <i class="bi bi-arrow-up-right mr-1"></i> 12% <span class="text-slate-600 font-normal ml-1">dari
                    kemarin</span>
                </p>
              </div>
              <div
                class="w-9 h-9 rounded-lg bg-blue-500/10 flex items-center justify-center border border-[#5ca82f]/20 group-hover:scale-105 transition-transform duration-300">
                <i class="bi bi-people text-[#5ca82f] text-base"></i>
              </div>
            </div>
            <!-- Sparkline grafik mini visitor hari ini -->
            <div class="absolute bottom-2 right-4 w-24 h-8 z-0 opacity-80" id="sparkline-visitor"></div>
          </div>

          <!-- Metrik 2: Paket Hari Ini -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 hover:border-emerald-500/30 hover:shadow-lg hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col justify-between h-32 relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-emerald-500 rounded-l-xl"></div>
            <div class="flex justify-between items-start pl-2 z-10">
              <div>
                <p class="text-[10px] font-medium text-slate-600 uppercase tracking-wider">Paket Hari Ini</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1.5 leading-none">
                  <%= packagesToday.length %>
                </h3>
                <p class="text-[10px] font-semibold text-emerald-400 mt-2 flex items-center">
                  <i class="bi bi-arrow-up-right mr-1"></i> 8% <span class="text-slate-600 font-normal ml-1">dari
                    kemarin</span>
                </p>
              </div>
              <div
                class="w-9 h-9 rounded-lg bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20 group-hover:scale-105 transition-transform duration-300">
                <i class="bi bi-box-seam text-emerald-400 text-base"></i>
              </div>
            </div>
            <!-- Sparkline grafik mini paket hari ini -->
            <div class="absolute bottom-2 right-4 w-24 h-8 z-0 opacity-80" id="sparkline-package"></div>
          </div>

          <!-- Metrik 3: Visitor Bulan Ini -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/5 transition-all duration-300 flex flex-col justify-between h-32 relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-purple-500 rounded-l-xl"></div>
            <div class="flex justify-between items-start pl-2 z-10">
              <div>
                <p class="text-[10px] font-medium text-slate-600 uppercase tracking-wider">Visitor Bulan Ini</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1.5 leading-none">
                  <%= monthlyVisitors %>
                </h3>
                <p class="text-[10px] font-semibold text-emerald-400 mt-2 flex items-center">
                  <i class="bi bi-arrow-up-right mr-1"></i> 24% <span class="text-slate-600 font-normal ml-1">dari bulan
                    lalu</span>
                </p>
              </div>
              <div
                class="w-9 h-9 rounded-lg bg-purple-500/10 flex items-center justify-center border border-purple-500/20 group-hover:scale-105 transition-transform duration-300">
                <i class="bi bi-calendar-month text-purple-400 text-base"></i>
              </div>
            </div>
            <!-- Sparkline grafik mini visitor bulanan -->
            <div class="absolute bottom-2 right-4 w-24 h-8 z-0 opacity-80" id="sparkline-monthly-visitor"></div>
          </div>

          <!-- Metrik 4: Paket Bulan Ini -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 hover:border-amber-500/30 hover:shadow-lg hover:shadow-amber-500/5 transition-all duration-300 flex flex-col justify-between h-32 relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-amber-500 rounded-l-xl"></div>
            <div class="flex justify-between items-start pl-2 z-10">
              <div>
                <p class="text-[10px] font-medium text-slate-600 uppercase tracking-wider">Paket Bulan Ini</p>
                <h3 class="text-2xl font-bold text-slate-800 mt-1.5 leading-none">
                  <%= monthlyPackages %>
                </h3>
                <p class="text-[10px] font-semibold text-emerald-400 mt-2 flex items-center">
                  <i class="bi bi-arrow-up-right mr-1"></i> 15% <span class="text-slate-600 font-normal ml-1">dari bulan
                    lalu</span>
                </p>
              </div>
              <div
                class="w-9 h-9 rounded-lg bg-amber-500/10 flex items-center justify-center border border-amber-500/20 group-hover:scale-105 transition-transform duration-300">
                <i class="bi bi-truck text-amber-400 text-base"></i>
              </div>
            </div>
            <!-- Sparkline grafik mini paket bulanan -->
            <div class="absolute bottom-2 right-4 w-24 h-8 z-0 opacity-80" id="sparkline-monthly-package"></div>
          </div>
        </div>

        <!-- ================= BAGIAN VISUALISASI UTAMA & AKTIVITAS (GRID OF 3 SECTIONS) ================= -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

          <!-- Area 1: Grafik Garis Ganda Tren Kunjungan (7 Hari) -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 lg:col-span-5 flex flex-col justify-between h-[360px]">
            <div class="flex justify-between items-center mb-2">
              <h4 class="text-xs font-bold text-slate-800 tracking-wide uppercase">Trend Kunjungan (7 Hari Terakhir)
              </h4>
              <div class="flex items-center space-x-3 text-[10px] uppercase font-bold text-slate-600">
                <span class="flex items-center"><span
                    class="w-2.5 h-2.5 rounded-full bg-blue-500 mr-1.5"></span>Visitor</span>
                <span class="flex items-center"><span
                    class="w-2.5 h-2.5 rounded-full bg-emerald-500 mr-1.5"></span>Paket</span>
              </div>
            </div>
            <div class="flex-1" id="main-trend-chart"></div>
          </div>

          <!-- Area 2: Grafik Donat Status Kunjungan -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 lg:col-span-3 flex flex-col justify-between h-[360px]">
            <h4 class="text-xs font-bold text-slate-800 tracking-wide uppercase mb-2">Status Kunjungan</h4>
            <div class="relative flex justify-center items-center h-48">
              <div class="w-full h-full" id="visitor-status-chart"></div>
            </div>
            <!-- Legenda Donat Chart -->
            <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-[10px] text-slate-600 border-t border-slate-800/60 pt-3">
              <div class="flex items-center"><span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span>Approved
              </div>
              <div class="flex items-center"><span class="w-2 h-2 rounded-full bg-amber-500 mr-1.5"></span>Pending</div>
              <div class="flex items-center"><span class="w-2 h-2 rounded-full bg-blue-500 mr-1.5"></span>Checked-in
              </div>
              <div class="flex items-center"><span class="w-2 h-2 rounded-full bg-purple-500 mr-1.5"></span>Reschedule
              </div>
              <div class="flex items-center col-span-2"><span
                  class="w-2 h-2 rounded-full bg-rose-500 mr-1.5"></span>Rejected</div>
            </div>
          </div>

          <!-- Area 3: Feed Garis Waktu Aktivitas Terkini -->
          <div class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 lg:col-span-4 flex flex-col h-[360px]">
            <div class="flex justify-between items-center mb-4">
              <h4 class="text-xs font-bold text-slate-800 tracking-wide uppercase">Aktivitas Terkini</h4>
              <button class="text-[10px] font-bold text-[#5ca82f] hover:underline" data-bs-toggle="modal"
                data-bs-target="#detailModal">Lihat Semua</button>
            </div>
            <div class="flex-1 overflow-y-auto space-y-4 pr-1">
              <% if (recentActivities.length===0) { %>
                <div class="text-center text-slate-600 py-12 text-xs">Belum ada aktivitas hari ini.</div>
                <% } else { %>
                  <% recentActivities.slice(0, 5).forEach(a=> { %>
                    <div class="flex items-start justify-between text-xs py-1 group">
                      <div class="flex items-start space-x-3">
                        <!-- Tipe Aktivitas Visitor -->
                        <% if (a.type==='visitor' ) { %>
                          <div
                            class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center shrink-0 border border-[#5ca82f]/20 group-hover:scale-105 transition-transform duration-200">
                            <i class="bi bi-person text-[#5ca82f] text-sm"></i>
                          </div>
                          <div>
                            <p class="font-semibold text-slate-800">Visitor baru: <%= a.name %>
                            </p>
                            <p class="text-[10px] text-slate-600 mt-0.5">Keperluan: <%= a.purpose %>
                            </p>
                          </div>
                          <!-- Tipe Aktivitas Paket -->
                          <% } else if (a.type==='package' ) { %>
                            <div
                              class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center shrink-0 border border-emerald-500/20 group-hover:scale-105 transition-transform duration-200">
                              <i class="bi bi-box-seam text-emerald-400 text-sm"></i>
                            </div>
                            <div>
                              <p class="font-semibold text-slate-800">Paket baru diterima</p>
                              <p class="text-[10px] text-slate-600 mt-0.5">Penerima: <%= a.recipient %> (Kurir: <%=
                                    a.courier %>)</p>
                            </div>
                            <% } %>
                      </div>
                      <!-- Waktu Aktivitas -->
                      <span class="text-[9px] text-slate-600 font-mono mt-1 shrink-0">
                        <%= new Date(a.date).toLocaleTimeString('id-ID', { hour: '2-digit' , minute: '2-digit' }) %>
                      </span>
                    </div>
                    <% }) %>
                      <% } %>
            </div>
          </div>
        </div>

        <!-- ================= BAGIAN TABEL DATA PREVIEW (GRID OF 2 TABLES) ================= -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">

          <!-- ================= BAGIAN TABEL VISITOR TERBARU ================= -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 flex flex-col justify-between min-h-[350px]">
            <div>
              <div class="flex justify-between items-center mb-4">
                <h4 class="text-xs font-bold text-slate-800 tracking-wide uppercase">Daftar Visitor Terbaru</h4>
                <!-- Search input tabel visitor -->
                <div class="relative w-44">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                    <i class="bi bi-search text-slate-400 text-[10px]"></i>
                  </span>
                  <input type="text" id="searchVisitorInput"
                    class="w-full bg-slate-50 border border-slate-200 text-[11px] text-slate-800 rounded-lg pl-7 pr-3 py-1 focus:outline-none focus:ring-1 focus:ring-[#1e3a8a] focus:border-transparent placeholder-slate-400"
                    placeholder="Cari visitor...">
                </div>
              </div>

              <div class="overflow-x-auto">
                <table id="visitorTable" class="w-full text-left border-collapse text-[11px]">
                  <thead>
                    <tr
                      class="border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[9px]">
                      <th class="py-2.5 pb-2">No</th>
                      <th class="py-2.5 pb-2">Nama / Instansi / HP</th>
