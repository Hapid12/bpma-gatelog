    // Tambah Visitor button: show modal pilihan form
    document.getElementById('btnTambahVisitor').addEventListener('click', function() {
      var modal = new bootstrap.Modal(document.getElementById('modalPilihForm'));
      modal.show();
    });

    // Bootstrap tab event: resize chart when tab is shown
    document.querySelectorAll('button[data-bs-toggle="pill"]').forEach(tabBtn => {
      tabBtn.addEventListener('shown.bs.tab', function (event) {
        if (event.target.id === 'visitor-chart-tab') {
          visitorChart.resize();
        } else if (event.target.id === 'package-chart-tab') {
          packageChart.resize();
        } else if (event.target.id === 'comparison-chart-tab') {
          comparisonChart.resize();
        }
      });
    });

    function paginateTable(tableId, paginationId, rowsPerPage) {
      const table = document.getElementById(tableId);
      if (!table) return;
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const pagination = document.getElementById(paginationId);
      let currentPage = 1;
      const totalPages = Math.ceil(rows.length / rowsPerPage);

      function showPage(page) {
        currentPage = page;
        rows.forEach((row, i) => {
          row.style.display = (i >= (page-1)*rowsPerPage && i < page*rowsPerPage) ? '' : 'none';
        });
        renderPagination();
      }

      function renderPagination() {
        pagination.innerHTML = '';
        if (totalPages <= 1) return;
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.textContent = i;
          btn.className = 'btn btn-sm mx-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
          btn.onclick = () => showPage(i);
          pagination.appendChild(btn);
        }
      }

      showPage(1);
    }

    paginateTable('visitorTable', 'visitorPagination', 5);
    paginateTable('packageTable', 'packagePagination', 5);

    // Visitor search filter
const searchInput = document.getElementById('searchVisitorInput');
const visitorTableBody = document.getElementById('visitorTableBody');

if (searchInput && visitorTableBody) {
  searchInput.addEventListener('input', function () {
    const filter = this.value.toLowerCase();
    const rows = visitorTableBody.getElementsByTagName('tr');

    Array.from(rows).forEach(row => {
      const match = Array.from(row.getElementsByTagName('td')).some(cell =>
        cell.textContent.toLowerCase().includes(filter)
      );
      row.style.display = match ? '' : 'none';
    });
  });
}

function setupPaginatedSearch(tableId, paginationId, searchInputId, itemsPerPage) {
  const table = document.getElementById(tableId);
  const tbody = table.querySelector('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  const pagination = document.getElementById(paginationId);
  const searchInput = document.getElementById(searchInputId);

  let currentPage = 1;
  let filteredRows = rows;

  function showRows() {
    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    rows.forEach(row => row.style.display = 'none');
    filteredRows.slice(start, end).forEach(row => row.style.display = '');
  }

  function renderPagination() {
    pagination.innerHTML = '';
    const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
    if (totalPages <= 1) return;
    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('button');
      btn.textContent = i;
      btn.className = 'btn btn-sm mx-1 ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
      btn.onclick = () => {
        currentPage = i;
        showRows();
        renderPagination();
      };
      pagination.appendChild(btn);
    }
  }

  function filterRows() {
    const keyword = searchInput.value.toLowerCase();
    filteredRows = rows.filter(row =>
      row.innerText.toLowerCase().includes(keyword)
    );
    currentPage = 1;
    renderPagination();
    showRows();
  }

  searchInput.addEventListener('input', filterRows);

  filterRows(); // Initial render
}

// Aktifkan untuk masing-masing tabel
setupPaginatedSearch('visitorTable', 'visitorPagination', 'searchVisitorInput', 5);
setupPaginatedSearch('packageTable', 'packagePagination', 'searchPackageInput', 5);

    // Edit button handler (inside modal detail visitor)
document.querySelectorAll('#detailModal .btn-warning').forEach(btn => {
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    const row = btn.closest('tr');
    const id = btn.getAttribute('href').split('/').pop();
    document.getElementById('editVisitorId').value = id;
    document.getElementById('editVisitorName').value = row.children[1].innerText;
    document.getElementById('editVisitorPurpose').value = row.children[2].innerText;
    document.getElementById('editVisitorStatus').value = row.children[4].innerText.trim().toLowerCase();
    var modal = new bootstrap.Modal(document.getElementById('editVisitorModal'));
    modal.show();
  });
});

// Submit edit form via AJAX
document.getElementById('editVisitorForm').addEventListener('submit', function(e) {
  e.preventDefault();
  const id = document.getElementById('editVisitorId').value;
  const name = document.getElementById('editVisitorName').value;
  const purpose = document.getElementById('editVisitorPurpose').value;
  const status = document.getElementById('editVisitorStatus').value;
  fetch(`/visitor/edit/${id}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, purpose, status })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      location.reload(); // Refresh page to update table
    } else {
      alert('Gagal update data');
    }
  });
});

// Hapus visitor via AJAX
document.querySelectorAll('#detailModal form[action^="/visitor/delete"]').forEach(form => {
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    Swal.fire({
      title: 'Yakin hapus data ini?',
      text: 'Data yang dihapus tidak dapat dikembalikan!',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#3085d6',
      confirmButtonText: 'Ya, hapus!',
      cancelButtonText: 'Batal'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(form.action, { method: 'POST' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire('Terhapus!', 'Data berhasil dihapus.', 'success')
                .then(() => location.reload());
            } else {
              Swal.fire('Gagal!', 'Gagal menghapus data.', 'error');
            }
          });
      }
    });
  });
});

  </script>
