  <!-- ================= BAGIAN MODAL DETAIL VISITOR ================= -->
  <div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title font-bold" id="detailModalLabel">Detail Semua Visitor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body p-0">
          <div class="sticky-table-scroll">
            <table class="table table-hover table-striped align-middle mb-0 text-xs text-slate-800">
              <thead>
                <tr class="border-b border-slate-700 text-slate-700 font-semibold uppercase text-[10px] tracking-wider">
                  <th class="text-center py-3" style="min-width:50px">No</th>
                  <th class="py-3" style="min-width:120px">Nama</th>
                  <th class="py-3" style="min-width:120px">NIK</th>
                  <th class="py-3" style="min-width:135px">Nomor HP</th>
                  <th class="py-3" style="min-width:150px">Email</th>
                  <th class="py-3" style="min-width:120px">Instansi</th>
                  <th class="py-3" style="min-width:120px">Jenis</th>
                  <th class="py-3" style="min-width:150px">Pegawai yang ditemui</th>
                  <th class="py-3" style="min-width:70px">Janji</th>
                  <th class="py-3" style="min-width:150px">Keperluan</th>
                  <th class="text-center py-3" style="min-width:70px">Tamu</th>
                  <th class="py-3" style="min-width:110px">Tgl Kunjungan</th>
                  <th class="py-3" style="min-width:90px">Jam</th>
                  <th class="py-3" style="min-width:130px">Waktu Input</th>
                  <th class="text-center py-3" style="min-width:105px">Prioritas</th>
                  <th class="text-center py-3" style="min-width:90px">Status</th>
                  <th class="text-center py-3" style="min-width:100px">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% allVisitors.forEach((v, i)=> { %> <tr class="border-b border-slate-200 text-slate-700">
                    <td class="text-center py-2.5">
                      <%= i + 1 %>
                    </td>
                    <td class="font-bold text-slate-800">
                      <%= v.name %>
                    </td>
                    <td>
                      <%= v.nik %>
                    </td>
                    <td>
                      <% if (v.phoneNumber && v.phoneNumber !=='-' ) { %>
                        <% let waPhone=v.phoneNumber.replace(/\D/g, '' ); if (waPhone.startsWith('0')) { waPhone='62' +
                          waPhone.substring(1); } %>
                          <a href="https://wa.me/<%= waPhone %>" target="_blank"
                            class="text-emerald-600 hover:text-emerald-700 font-semibold inline-flex items-center gap-1">
                            <i class="fab fa-whatsapp"></i>
                            <%= v.phoneNumber %>
                          </a>
                          <% } else { %>
                            -
                            <% } %>
                    </td>
                    <td>
                      <%= v.email %>
                    </td>
                    <td>
                      <%= v.instansi || v.institution || '-' %>
                    </td>
                    <td>
                      <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[9px] font-bold uppercase">
                        <%= v.visitCategory || 'Meeting' %>
                      </span>
                    </td>
                    <td>
                      <%= v.bertemu || v.targetEmployee || '-' %>
                    </td>
                    <td class="capitalize">
                      <%= v.janji || v.hasAppointment || '-' %>
                    </td>
                    <td>
                      <%= v.purpose %>
                    </td>
                    <td class="text-center">
                      <%= v.rekan !==undefined ? v.rekan : (v.companions !==undefined ? v.companions : '-' ) %>
                    </td>
                    <td>
                      <%= v.tanggal || (v.schedule ? new Date(v.schedule).toLocaleDateString('id-ID') : '-' ) %>
                    </td>
                    <td>
                      <%= v.jam || (v.schedule ? new Date(v.schedule).toLocaleTimeString('id-ID', {hour: '2-digit' ,
                        minute:'2-digit'}) : '-' ) %>
                    </td>
                    <td class="font-mono text-slate-600 text-[10px]">
                      <%= new Date(v.date).toLocaleString("id-ID") %>
                    </td>
                    <td class="text-center">
                      <% let prioText=v.priority || 'Normal' ; let
                        prioClass='bg-emerald-50 text-emerald-700 border border-emerald-200' ; let prioIcon='🟢' ; if
                        (prioText==='Mendesak' ) { prioClass='bg-rose-50 text-rose-700 border border-rose-200' ;
                        prioIcon='🔴' ; } else if (prioText==='Penting' ) {
                        prioClass='bg-amber-50 text-amber-700 border border-amber-200' ; prioIcon='🟡' ; } %>
                        <span
                          class="px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider <%= prioClass %>">
                          <%= prioIcon %>
                            <%= prioText %>
                        </span>
                    </td>
                    <td class="text-center">
                      <% let stat=v.status || 'pending' ; let
                        statClass='bg-amber-50 text-amber-700 border border-amber-200' ; if (stat==='approved' )
                        statClass='bg-emerald-50 text-emerald-700 border border-emerald-200' ; else if
                        (stat==='rejected' ) statClass='bg-rose-50 text-rose-700 border border-rose-200' ; else if
                        (stat==='reschedule' ) statClass='bg-purple-50 text-purple-700 border border-purple-200' ; else
                        if (stat==='checked-in' ) statClass='bg-blue-50 text-blue-700 border border-blue-200' ; else if
                        (stat==='checked-out' ) statClass='bg-slate-100 text-slate-700 border border-slate-200' ; %>
                        <span
                          class="px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider <%= statClass %>">
                          <%= stat %>
                        </span>
                    </td>
                    <td class="text-center">
                      <% if (user && user.role==='admin' ) { %>
                        <div class="flex items-center justify-center space-x-1.5">
                          <a href="/visitor/edit/<%= v._id %>"
                            class="btn btn-sm btn-warning bg-amber-500 hover:bg-amber-600 border-none text-black p-1 px-1.5 rounded"><i
                              class="bi bi-pencil"></i></a>
                          <form action="/visitor/delete/<%= v._id %>" method="POST" class="form-delete-visitor m-0">
                            <button type="submit"
                              class="btn btn-sm btn-danger bg-rose-550 hover:bg-rose-600 border-none p-1 px-1.5 rounded"><i
                                class="bi bi-trash"></i></button>
                          </form>
                        </div>
                        <% } else { %>
                          <span class="text-slate-600 text-[10px]">—</span>
                          <% } %>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button"
            class="btn btn-light bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 rounded-lg text-xs"
            data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </div>
  </div>

