<%- include('partials/header', { currentPath: request.url }) %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - BPMA GateLog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <link href="/css/style.css" rel="stylesheet">
  <style>
    :root {
      --primary-blue: #3498db;
      --secondary-green: #2ecc71;
      --accent-red: #e74c3c;
      --light-gray: #f8f9fa;
      --dark-gray: #343a40;
    }
    
    body {
      background-color: #ffffff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .dashboard-header {
      background: linear-gradient(135deg, var(--primary-blue), var(--secondary-green));
      color: white;
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 30px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    
    .stat-card {
      border-radius: 10px;
      border: none;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      transition: transform 0.3s ease;
      margin-bottom: 20px;
    }
    
    .stat-card:hover {
      transform: translateY(-5px);
    }
    
    .stat-card.blue {
      border-left: 4px solid var(--primary-blue);
    }
    
    .stat-card.green {
      border-left: 4px solid var(--secondary-green);
    }
    
    .stat-card.red {
      border-left: 4px solid var(--accent-red);
    }
    
    .stat-icon {
      font-size: 2rem;
      opacity: 0.8;
    }
    
    .chart-container {
      background: white;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      margin-bottom: 30px;
    }
    
    .table-container {
      background: white;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      padding: 20px;
      margin-bottom: 30px;
    }
    
    .badge-visitor {
      background-color: rgba(52, 152, 219, 0.2);
      color: var(--primary-blue);
    }
    
    .badge-package {
      background-color: rgba(46, 204, 113, 0.2);
      color: var(--secondary-green);
    }
    
    .badge-alert {
      background-color: rgba(231, 76, 60, 0.2);
      color: var(--accent-red);
    }
    
    .nav-pills .nav-link.active {
      background: linear-gradient(135deg, var(--primary-blue), var(--secondary-green));
    }
    
    .search-box {
      border-radius: 20px;
      border: 1px solid #e0e0e0;
      padding-left: 20px;
    }
    
    .quick-actions {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }
    
    .quick-action-btn {
      border-radius: 8px;
      padding: 10px 15px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    
    .recent-activity-item {
      border-left: 3px solid var(--primary-blue);
      padding-left: 15px;
      margin-bottom: 15px;
    }
    
    .activity-time {
      font-size: 0.8rem;
      color: #6c757d;
    }
  </style>
</head>
<body>
  <div class="container-fluid py-4">
    <div class="dashboard-header">
      <div class="row align-items-center">
        <div class="col-md-6">
          <h1><i class="bi bi-door-open"></i> GateLog Dashboard</h1>
          <p class="mb-0">Selamat datang di sistem manajemen akses BPMA</p>
        </div>
        <div class="col-md-6 text-md-end">
          <span class="badge bg-light text-dark me-2"><i class="bi bi-calendar me-1"></i> <span id="current-date"></span></span>
          <span class="badge bg-light text-dark"><i class="bi bi-clock me-1"></i> <span id="current-time"></span></span>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
      <button class="btn btn-primary quick-action-btn" id="btnTambahVisitor" type="button">
        <i class="bi bi-plus-circle"></i> Tambah Visitor
      </button>
      <button class="btn btn-success quick-action-btn">
        <i class="bi bi-box-seam"></i> Input Paket
      </button>
      <button class="btn btn-secondary quick-action-btn">
        <i class="bi bi-printer"></i> Cetak Laporan
      </button>
    </div>

    <!-- Modal Pilihan Form -->
    <div class="modal fade" id="modalPilihForm" tabindex="-1" aria-labelledby="modalPilihFormLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modalPilihFormLabel">Pilih Jenis Form</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
          </div>
          <div class="modal-body text-center">
            <a href="/visitor" class="btn btn-primary m-2">
              <i class="bi bi-person-plus"></i> Form Tamu
            </a>
            <a href="/package" class="btn btn-success m-2">
              <i class="bi bi-box-seam"></i> Form Paket
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="row">
      <div class="col-xl-3 col-md-6">
        <div class="stat-card blue card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Visitor Hari Ini</h5>
                <h2 class="mb-0"><%= visitorsToday.length %></h2>
                <p class="mb-0 text-muted"><span class="text-success"><i class="bi bi-arrow-up"></i> 12%</span> dari kemarin</p>
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-people stat-icon text-primary"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-xl-3 col-md-6">
        <div class="stat-card green card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Paket Hari Ini</h5>
                <h2 class="mb-0"><%= packagesToday.length %></h2>
                <p class="mb-0 text-muted"><span class="text-success"><i class="bi bi-arrow-up"></i> 5%</span> dari kemarin</p>
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-box-seam stat-icon text-success"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-xl-3 col-md-6">
        <div class="stat-card red card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Visitor Bulan Ini</h5>
                <h2 class="mb-0"><%= monthlyVisitors %></h2>
                <p class="mb-0 text-muted"><span class="text-success"><i class="bi bi-arrow-up"></i> 8%</span> dari bulan lalu</p>
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-calendar-month stat-icon text-danger"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-xl-3 col-md-6">
        <div class="stat-card blue card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Paket Bulan Ini</h5>
                <h2 class="mb-0"><%= monthlyPackages %></h2>
                <p class="mb-0 text-muted"><span class="text-danger"><i class="bi bi-arrow-down"></i> 3%</span> dari bulan lalu</p>
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-truck stat-icon text-primary"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <!-- Main Charts -->
      <div class="col-lg-8">
        <div class="chart-container">
          <ul class="nav nav-pills mb-3" id="chart-tab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="visitor-chart-tab" data-bs-toggle="pill" data-bs-target="#visitor-chart" type="button" role="tab">Visitor</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="package-chart-tab" data-bs-toggle="pill" data-bs-target="#package-chart" type="button" role="tab">Paket</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="comparison-chart-tab" data-bs-toggle="pill" data-bs-target="#comparison-chart" type="button" role="tab">Perbandingan</button>
            </li>
          </ul>
          <div class="tab-content" id="chart-tabContent">
            <div class="tab-pane fade show active" id="visitor-chart" role="tabpanel">
              <canvas id="visitorChart" height="150"></canvas>
            </div>
            <div class="tab-pane fade" id="package-chart" role="tabpanel">
              <canvas id="packageChart" height="150"></canvas>
            </div>
            <div class="tab-pane fade" id="comparison-chart" role="tabpanel">
              <canvas id="comparisonChart" height="150"></canvas>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Recent Activity -->
      <div class="col-lg-4">
        <div class="chart-container">
          <h5><i class="bi bi-activity me-2"></i> Aktivitas Terkini</h5>
          <div class="mt-3">
            <div class="recent-activity-item">
              <h6>Visitor baru: Budi Santoso</h6>
              <p class="mb-1">Keperluan: Meeting dengan Marketing</p>
              <p class="activity-time">2 menit yang lalu</p>
            </div>
            <div class="recent-activity-item">
              <h6>Paket diterima: Ani Wijaya</h6>
              <p class="mb-1">Kurir: JNE Express</p>
              <p class="activity-time">15 menit yang lalu</p>
            </div>
            <div class="recent-activity-item">
              <h6>Visitor keluar: Siti Rahma</h6>
              <p class="mb-1">Durasi: 45 menit</p>
              <p class="activity-time">30 menit yang lalu</p>
            </div>
            <div class="recent-activity-item">
              <h6>Paket diambil: Dian Pratama</h6>
              <p class="mb-1">Penerima: Resepsionis</p>
              <p class="activity-time">1 jam yang lalu</p>
            </div>
          </div>
          <a href="#" class="btn btn-sm btn-outline-primary mt-2">Lihat Semua Aktivitas</a>
        </div>
      </div>
    </div>

    <!-- Data Tables -->
    <div class="row mt-4">
      <div class="col-lg-6">
        <div class="table-container">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5><i class="bi bi-people-fill me-2"></i> Visitor Hari Ini</h5>
            <div class="input-group" style="width: 200px;">
              <input type="text" class="form-control form-control-sm search-box" placeholder="Cari visitor...">
              <button class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>No</th>
                  <th>Nama</th>
                  <th>Keperluan</th>
                  <th>Waktu</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (visitorsToday.length === 0) { %>
                  <tr><td colspan="5" class="text-center py-4">Belum ada visitor hari ini.</td></tr>
                <% } else { %>
                  <% visitorsToday.forEach((v, i) => { %>
                    <tr>
                      <td><%= i + 1 %></td>
                      <td><strong><%= v.name %></strong></td>
                      <td><%= v.purpose %></td>
                      <td><%= new Date(v.date).toLocaleTimeString("id-ID") %></td>
                      <td><span class="badge badge-visitor"><i class="bi bi-check-circle me-1"></i> Masuk</span></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="d-flex justify-content-between align-items-center mt-3">
            <div>Menampilkan <%= Math.min(5, visitorsToday.length) %> dari <%= visitorsToday.length %> entri</div>
            <button class="btn btn-sm btn-outline-primary">Lihat Semua</button>
          </div>
        </div>
      </div>
      
      <div class="col-lg-6">
        <div class="table-container">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5><i class="bi bi-box-seam me-2"></i> Paket Hari Ini</h5>
            <div class="input-group" style="width: 200px;">
              <input type="text" class="form-control form-control-sm search-box" placeholder="Cari paket...">
              <button class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>No</th>
                  <th>Penerima</th>
                  <th>Kurir</th>
                  <th>Waktu</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (packagesToday.length === 0) { %>
                  <tr><td colspan="5" class="text-center py-4">Belum ada paket hari ini.</td></tr>
                <% } else { %>
                  <% packagesToday.forEach((p, i) => { %>
                    <tr>
                      <td><%= i + 1 %></td>
                      <td><strong><%= p.recipient %></strong></td>
                      <td><%= p.courier %></td>
                      <td><%= new Date(p.date).toLocaleTimeString("id-ID") %></td>
                      <td><span class="badge badge-package"><i class="bi bi-box-seam me-1"></i> Belum diambil</span></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="d-flex justify-content-between align-items-center mt-3">
            <div>Menampilkan <%= Math.min(5, packagesToday.length) %> dari <%= packagesToday.length %> entri</div>
            <button class="btn btn-sm btn-outline-primary">Lihat Semua</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Update current date and time
    function updateDateTime() {
      const now = new Date();
      document.getElementById('current-date').textContent = now.toLocaleDateString('id-ID', { 
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' 
      });
      document.getElementById('current-time').textContent = now.toLocaleTimeString('id-ID');
    }
    setInterval(updateDateTime, 1000);
    updateDateTime();

    // Visitor Chart
    const visitorCtx = document.getElementById('visitorChart').getContext('2d');
    const visitorChart = new Chart(visitorCtx, {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(chartLabels) %>,
        datasets: [{
          label: 'Jumlah Visitor',
          data: <%- JSON.stringify(chartData) %>,
          borderColor: 'rgba(52, 152, 219, 1)',
          backgroundColor: 'rgba(52, 152, 219, 0.1)',
          borderWidth: 2,
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
          },
          tooltip: {
            mode: 'index',
            intersect: false,
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });

    // Package Chart
    const packageCtx = document.getElementById('packageChart').getContext('2d');
    const packageChart = new Chart(packageCtx, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(chartLabels) %>,
        datasets: [{
          label: 'Jumlah Paket',
          data: <%- JSON.stringify(packageChartData) %>,
          backgroundColor: 'rgba(46, 204, 113, 0.7)',
          borderColor: 'rgba(46, 204, 113, 1)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });

    // Comparison Chart
    const comparisonCtx = document.getElementById('comparisonChart').getContext('2d');
    const comparisonChart = new Chart(comparisonCtx, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(chartLabels) %>,
        datasets: [
          {
            label: 'Visitor',
            data: <%- JSON.stringify(chartData) %>,
            backgroundColor: 'rgba(52, 152, 219, 0.7)',
            borderColor: 'rgba(52, 152, 219, 1)',
            borderWidth: 1
          },
          {
            label: 'Paket',
            data: <%- JSON.stringify(packageChartData) %>,
            backgroundColor: 'rgba(46, 204, 113, 0.7)',
            borderColor: 'rgba(46, 204, 113, 1)',
            borderWidth: 1
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'top',
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });

    // Tambah Visitor button: show modal pilihan form
    document.getElementById('btnTambahVisitor').addEventListener('click', function() {
      var modal = new bootstrap.Modal(document.getElementById('modalPilihForm'));
      modal.show();
    });
  </script>
  <%- include('partials/footer') %>
</body>
</html>