<%- include('partials/header', { currentPath: request.url }) %>


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - BPMA GateLog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-4 text-center">Dashboard BPMA GateLog</h1>

    <!-- Ringkasan -->
    <div class="row text-center mb-5">
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Total Visitor Hari Ini</h5>
            <h2 class="text-primary"><%= visitorsToday.length %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Total Paket Hari Ini</h5>
            <h2 class="text-success"><%= packagesToday.length %></h2>
          </div>
        </div>
      </div>
    </div>

    <!-- Grafik Mingguan -->
    <div class="card mb-5 shadow-sm">
      <div class="card-body">
        <h5 class="text-center mb-3">Grafik Visitor 7 Hari Terakhir</h5>
        <canvas id="visitorChart"></canvas>
      </div>
    </div>

    <!-- Tabel Visitor Hari Ini -->
    <h3>Visitor Hari Ini</h3>
    <div class="table-responsive mb-4 shadow-sm">
      <table class="table table-bordered table-hover">
        <thead class="table-dark">
          <tr>
            <th>No</th>
            <th>Nama</th>
            <th>Keperluan</th>
            <th>Jam</th>
          </tr>
        </thead>
        <tbody>
          <% if (visitorsToday.length === 0) { %>
            <tr><td colspan="4" class="text-center">Belum ada visitor hari ini.</td></tr>
          <% } else { %>
            <% visitorsToday.forEach((v, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= v.name %></td>
                <td><%= v.purpose %></td>
                <td><%= new Date(v.date).toLocaleTimeString("id-ID") %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Tabel Paket Hari Ini -->
    <h3>Paket Hari Ini</h3>
    <div class="table-responsive shadow-sm">
      <table class="table table-bordered table-hover">
        <thead class="table-dark">
          <tr>
            <th>No</th>
            <th>Nama Penerima</th>
            <th>Kurir</th>
            <th>Jam</th>
          </tr>
        </thead>
        <tbody>
          <% if (packagesToday.length === 0) { %>
            <tr><td colspan="4" class="text-center">Belum ada paket hari ini.</td></tr>
          <% } else { %>
            <% packagesToday.forEach((p, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= p.recipient %></td>
                <td><%= p.courier %></td>
                <td><%= new Date(p.date).toLocaleTimeString("id-ID") %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Script Grafik -->
  <script>
    const ctx = document.getElementById('visitorChart').getContext('2d');
    const visitorChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(chartLabels) %>,
        datasets: [{
          label: 'Jumlah Visitor',
          data: <%- JSON.stringify(chartData) %>,
          borderColor: 'rgba(54, 162, 235, 1)',
          backgroundColor: 'rgba(54, 162, 235, 0.2)',
          borderWidth: 2,
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        scales: {
          y: {
            beginAtZero: true,
            precision: 0
          }
        }
      }
    });
  </script>
  <%- include('partials/footer') %>
</body>
</html>
