                    <tr
                      class="border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[9px]">
                      <th class="py-2.5 pb-2">No</th>
                      <th class="py-2.5 pb-2">No. Resi</th>
                      <th class="py-2.5 pb-2">Kurir</th>
                      <th class="py-2.5 pb-2">Penerima</th>
                      <th class="py-2.5 pb-2">Waktu</th>
                      <th class="py-2.5 pb-2 text-right">Status</th>
