                                    class="far fa-building mr-1"></i>
                                  <%= v.institution || v.instansi %>
                                </span>
                                <% } %>
                                  <% if (v.phoneNumber && v.phoneNumber !=='-' ) { %>
                                    <% let waPhone=v.phoneNumber.replace(/\D/g, '' ); if (waPhone.startsWith('0')) {
                                      waPhone='62' + waPhone.substring(1); } %>
                                      <span class="block text-[9px] mt-0.5">
                                        <a href="https://wa.me/<%= waPhone %>" target="_blank"
