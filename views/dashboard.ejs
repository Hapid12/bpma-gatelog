                                prioClass='bg-rose-50 text-rose-700 border border-rose-200' ; prioIcon='🔴' ; } else if
                                (prioText==='Penting' ) { prioClass='bg-amber-50 text-amber-700 border border-amber-200'
                                ; prioIcon='🟡' ; } %>
                                <span
                                  class="inline-block px-2 py-0.5 rounded text-[9px] font-semibold tracking-wide <%= prioClass %>">
                                  <%= prioIcon %>
                                    <%= prioText %>
                                </span>
                            </td>
                            <td class="py-2.5 text-slate-600 font-mono">
                              <%= new Date(v.date).toLocaleDateString('id-ID', {day: '2-digit' , month: '2-digit' }) %>
                                <span class="block text-[9px]">
                                  <%= new Date(v.date).toLocaleTimeString('id-ID', {hour: '2-digit' , minute:'2-digit'})
                                    %>
                                </span>
                            </td>
                            <td class="py-2.5 text-right">
                              <!-- Pengaturan warna badge status visitor -->
                              <% let statusText=v.status || 'pending' ; let badgeClass='' ; if (statusText==='approved'
                                ) { badgeClass='bg-emerald-50 text-emerald-700 border border-emerald-200' ;
                                statusText='Approved' ; } else if (statusText==='rejected' ) {
                                badgeClass='bg-rose-50 text-rose-700 border border-rose-200' ; statusText='Rejected' ; }
                                else if (statusText==='reschedule' ) {
                                badgeClass='bg-purple-50 text-purple-700 border border-purple-200' ;
                                statusText='Rescheduled' ; } else if (statusText==='checked-in' ) {
                                badgeClass='bg-blue-50 text-blue-700 border border-blue-200' ; statusText='Checked-In' ;
                                } else if (statusText==='checked-out' ) {
                                badgeClass='bg-slate-100 text-slate-700 border border-slate-200' ;
                                statusText='Checked-Out' ; } else {
                                badgeClass='bg-amber-50 text-amber-700 border border-amber-200' ; statusText='Pending' ;
                                } %>
                                <span
                                  class="inline-block px-2 py-0.5 rounded text-[9px] font-semibold tracking-wide <%= badgeClass %>">
                                  <%= statusText %>
                                </span>
                            </td>
                          </tr>
                          <% }) %>
                            <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Footer tabel visitor (Pagination & Detail modal trigger) -->
            <div
              class="flex justify-between items-center mt-4 border-t border-slate-200 pt-3 text-[10px] text-slate-600 shrink-0">
              <div>Menampilkan <span class="text-slate-700 font-semibold">
                  <%= Math.min(5, allVisitors.length) %>
                </span> dari <span class="text-slate-700 font-semibold">
                  <%= allVisitors.length %>
                </span> entri</div>
              <div class="flex items-center space-x-1" id="visitorPagination"></div>
              <button
                class="bg-[#5ca82f] hover:bg-[#4d8b26] text-white font-semibold px-3 py-1.5 rounded-lg text-[10px] transition-colors"
                data-bs-toggle="modal" data-bs-target="#detailModal">
                Detail
              </button>
            </div>
          </div>

          <!-- ================= BAGIAN TABEL PAKET TERBARU ================= -->
          <div
            class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 flex flex-col justify-between min-h-[350px]">
            <div>
              <div class="flex justify-between items-center mb-4">
                <h4 class="text-xs font-bold text-slate-800 tracking-wide uppercase">Paket Masuk Terbaru</h4>
                <!-- Search input tabel paket -->
                <div class="relative w-44">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                    <i class="bi bi-search text-slate-400 text-[10px]"></i>
                  </span>
                  <input type="text" id="searchPackageInput"
                    class="w-full bg-slate-50 border border-slate-200 text-[11px] text-slate-800 rounded-lg pl-7 pr-3 py-1 focus:outline-none focus:ring-1 focus:ring-[#1e3a8a] focus:border-transparent placeholder-slate-400"
                    placeholder="Cari paket...">
                </div>
              </div>

