                      <tr>
                        <td colspan="6" class="text-center py-8 text-slate-600">Belum ada paket.</td>
                      </tr>
                      <% } else { %>
                        <% allPackages.forEach((p, i)=> { %>
                          <tr class="hover:bg-slate-800/10 transition-colors text-slate-700">
                            <td class="py-2.5">
                              <%= i + 1 %>
                            </td>
                            <td class="py-2.5"><span class="font-semibold text-slate-800">
                                <%= p.nomorResi %>
                              </span></td>
                            <td class="py-2.5">
                              <%= p.namaKurir %>
                            </td>
                            <td class="py-2.5 text-slate-600">
                              <%= p.penerimaNama || '-' %>
                            </td>
                            <td class="py-2.5 text-slate-600 font-mono">
                              <%= p.createdAt ? new Date(p.createdAt).toLocaleDateString('id-ID', {day: '2-digit' ,
                                month: '2-digit' }) : '-' %>
                                <span class="block text-[9px]">
                                  <%= p.createdAt ? new Date(p.createdAt).toLocaleTimeString('id-ID', {hour: '2-digit' ,
                                    minute:'2-digit'}) : '-' %>
                                </span>
                            </td>
                            <td class="py-2.5 text-right">
                              <!-- Pengaturan warna badge status paket -->
                              <% let pkgStatus=p.status || 'belum diambil' ; let pkgStatusText='Belum Diambil' ; let
                                pkgBadgeClass='bg-amber-500/10 text-amber-400 border border-amber-500/20' ; if
                                (pkgStatus==='diambil' ) { pkgStatusText='Diambil' ;
                                pkgBadgeClass='bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' ; } %>
                                <span
                                  class="inline-block px-2 py-0.5 rounded text-[9px] font-semibold tracking-wide <%= pkgBadgeClass %>">
                                  <%= pkgStatusText %>
                                </span>
                            </td>
                          </tr>
                          <% }) %>
                            <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Footer tabel paket (Pagination & Detail modal trigger) -->
            <div
              class="flex justify-between items-center mt-4 border-t border-slate-800/40 pt-3 text-[10px] text-slate-600 shrink-0">
              <div>Menampilkan <span class="text-slate-700 font-semibold">
                  <%= Math.min(5, allPackages.length) %>
                </span> dari <span class="text-slate-700 font-semibold">
                  <%= allPackages.length %>
                </span> entri</div>
              <div class="flex items-center space-x-1" id="packagePagination"></div>
              <button
                class="bg-[#5ca82f]/90 hover:bg-[#4a8a24] text-slate-800 font-semibold px-3 py-1.5 rounded-lg text-[10px] transition-colors"
                data-bs-toggle="modal" data-bs-target="#detailPackageModal">
                Detail
              </button>
            </div>
          </div>
        </div>

        <!-- Footer Copyright Penulis -->
        <footer class="text-center text-slate-600 text-[10px] pt-12 pb-4">
          © 2026 BPMA GateLog - Sistem Informasi Manajemen Akses BPMA
        </footer>

      </main>
    </div>
  </div>

