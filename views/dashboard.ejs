<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - BPMA GateLog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <link href="/css/style.css" rel="stylesheet">
  <style>
    :root {
      --primary-blue: #3498db;
      --secondary-green: #2ecc71;
      --accent-red: #e74c3c;
      --light-gray: #f8f9fa;
      --dark-gray: #343a40;
    }
    
    body {
      background-color: #ffffff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .dashboard-header {
      background: linear-gradient(135deg, var(--primary-blue), var(--secondary-green));
      color: white;
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 30px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    
    .stat-card {
      border-radius: 10px;
      border: none;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      transition: transform 0.3s ease;
      margin-bottom: 20px;
    }
    
    .stat-card:hover {
      transform: translateY(-5px);
    }
    
    .stat-card.blue {
      border-left: 4px solid var(--primary-blue);
    }
    
    .stat-card.green {
      border-left: 4px solid var(--secondary-green);
    }
    
    .stat-card.red {
      border-left: 4px solid var(--accent-red);
    }
    
    .stat-icon {
      font-size: 2rem;
      opacity: 0.8;
    }
    
    .chart-container {
      background: white;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      margin-bottom: 30px;
    }
    
    .table-container {
      background: white;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      padding: 20px;
      margin-bottom: 30px;
    }
    
    .badge-visitor {
      background-color: rgba(52, 152, 219, 0.2);
      color: var(--primary-blue);
    }
    
    .badge-package {
      background-color: rgba(46, 204, 113, 0.2);
      color: var(--secondary-green);
    }
    
    .badge-alert {
      background-color: rgba(231, 76, 60, 0.2);
      color: var(--accent-red);
    }
    
    .nav-pills .nav-link.active {
      background: linear-gradient(135deg, var(--primary-blue), var(--secondary-green));
    }
    
    .search-box {
      border-radius: 20px;
      border: 1px solid #e0e0e0;
      padding-left: 20px;
    }
    
    .quick-actions {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }
    
    .quick-action-btn {
      border-radius: 8px;
      padding: 10px 15px;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    
    .recent-activity-item {
      border-left: 3px solid var(--primary-blue);
      padding-left: 15px;
      margin-bottom: 15px;
    }
    
    .activity-time {
      font-size: 0.8rem;
      color: #6c757d;
    }

    .badge-pending {
      background-color: #fff3cd;
      color: #856404;
    }
  </style>
</head>
<body>
  <div class="container-fluid py-4">
    <div class="dashboard-header">
      <div class="row align-items-center">
        <div class="col-md-6">
          <h1><i class="bi bi-door-open"></i> GateLog Dashboard</h1>
          <p class="mb-0">Selamat datang di sistem manajemen akses BPMA</p>
        </div>
        <div class="col-md-6 text-md-end">
          <span class="badge bg-light text-dark me-2"><i class="bi bi-calendar me-1"></i> <span id="current-date"></span></span>
          <span class="badge bg-light text-dark"><i class="bi bi-clock me-1"></i> <span id="current-time"></span></span>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
      <button class="btn btn-primary quick-action-btn" id="btnTambahVisitor" type="button">
        <i class="bi bi-plus-circle"></i> Tambah Data
      </button>

     
    </div>

    <!-- Modal Pilihan Form -->
    <div class="modal fade" id="modalPilihForm" tabindex="-1" aria-labelledby="modalPilihFormLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modalPilihFormLabel">Pilih Jenis Form</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
          </div>
          <div class="modal-body text-center">
            <a href="/visitor" class="btn btn-primary m-2">
              <i class="bi bi-person-plus"></i> Form Tamu
            </a>
            <a href="/package" class="btn btn-success m-2">
              <i class="bi bi-box-seam"></i> Form Paket
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="row">
      <div class="col-xl-3 col-md-6">
        <div class="stat-card blue card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Visitor Hari Ini</h5>
                <h2 class="mb-0"><%= visitorsToday.length %></h2>
                
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-people stat-icon text-primary"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-xl-3 col-md-6">
        <div class="stat-card green card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Paket Hari Ini</h5>
                <h2 class="mb-0"><%= packagesToday.length %></h2>
                
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-box-seam stat-icon text-success"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-xl-3 col-md-6">
        <div class="stat-card red card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Visitor Bulan Ini</h5>
                <h2 class="mb-0"><%= monthlyVisitors %></h2>
                
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-calendar-month stat-icon text-danger"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-xl-3 col-md-6">
        <div class="stat-card blue card">
          <div class="card-body">
            <div class="row align-items-center">
              <div class="col-8">
                <h5 class="text-muted mb-2">Paket Bulan Ini</h5>
                <h2 class="mb-0"><%= monthlyPackages %></h2>
                
              </div>
              <div class="col-4 text-end">
                <i class="bi bi-truck stat-icon text-primary"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <!-- Main Charts -->
      <div class="col-lg-8">
        <div class="chart-container">
          <ul class="nav nav-pills mb-3" id="chart-tab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="visitor-chart-tab" data-bs-toggle="pill" data-bs-target="#visitor-chart" type="button" role="tab">Visitor</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="package-chart-tab" data-bs-toggle="pill" data-bs-target="#package-chart" type="button" role="tab">Paket</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="comparison-chart-tab" data-bs-toggle="pill" data-bs-target="#comparison-chart" type="button" role="tab">Perbandingan</button>
            </li>
          </ul>
          <div class="tab-content" id="chart-tabContent">
            <div class="tab-pane fade show active" id="visitor-chart" role="tabpanel">
              <canvas id="visitorChart" height="150"></canvas>
            </div>
            <div class="tab-pane fade" id="package-chart" role="tabpanel">
              <canvas id="packageChart" height="150"></canvas>
            </div>
            <div class="tab-pane fade" id="comparison-chart" role="tabpanel">
              <canvas id="comparisonChart" height="150"></canvas>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Recent Activity -->
      <div class="col-lg-4">
        <div class="chart-container">
          <h5><i class="bi bi-activity me-2"></i> Aktivitas Terkini</h5>
          <div class="mt-3">
            <% if (recentActivities.length === 0) { %>
              <div class="recent-activity-item">
                <p class="mb-1">Belum ada aktivitas hari ini.</p>
              </div>
            <% } else { %>
              <% recentActivities.slice(0, 5).forEach(a => { %>
                <div class="recent-activity-item">
                  <% if (a.type === 'visitor') { %>
                    <h6>Visitor baru: <%= a.name %></h6>
                    <p class="mb-1">Keperluan: <%= a.purpose %></p>
                  <% } else if (a.type === 'package') { %>
                    <h6>Paket diterima: <%= a.recipient %></h6>
                    <p class="mb-1">Kurir: <%= a.courier %></p>
                  <% } %>
                  <p class="activity-time"><%= new Date(a.date).toLocaleTimeString('id-ID') %></p>
                </div>
              <% }) %>
            <% } %>
          </div>
          <a href="#" class="btn btn-sm btn-outline-primary mt-2">Lihat Semua Aktivitas</a>
        </div>
      </div>
    </div>

    <!-- Data Tables -->
    <div class="row mt-4">
      <div class="col-lg-6">
        <div class="table-container">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5><i class="bi bi-people-fill me-2"></i> Semua Visitor</h5>
            <div class="input-group" style="width: 200px;">
              <input type="text" id="searchVisitorInput" class="form-control form-control-sm search-box" placeholder="Cari visitor...">
              <button class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
            </div>
          </div>
          <div class="table-responsive">
            <table id="visitorTable" class="table table-hover">
              <thead class="table-light">
                <tr>
                  <th>No</th>
                  <th>Nama</th>
                  <th>Keperluan</th>
                  <th>Waktu</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="visitorTableBody">
                <% if (allVisitors.length === 0) { %>
                  <tr><td colspan="5" class="text-center py-4">Belum ada visitor.</td></tr>
                <% } else { %>
                  <% allVisitors.forEach((v, i) => { %>
                    <tr>
                      <td><%= i + 1 %></td>
                      <td><strong><%= v.name %></strong></td>
                      <td><%= v.purpose %></td>
                      <td><%= new Date(v.date).toLocaleString("id-ID") %></td>
                      <td>
                        <!-- Untuk Visitor -->
                        <span class="px-2 py-1 rounded-full text-xs font-semibold
                            <%= v.status === 'approved' ? 'bg-green-200 text-green-800' 
                              : v.status === 'rejected' ? 'bg-red-200 text-red-800' 
                              : v.status === 'reschedule' ? 'bg-blue-200 text-blue-800' 
                              : 'bg-yellow-200 text-yellow-800' %>">
                            <%= v.status || 'pending' %>
                          </span>

                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
          <!-- Tabel Visitor -->
          <div class="d-flex justify-content-between align-items-center mt-3">
            <div>Menampilkan <%= Math.min(5, allVisitors.length) %> dari <%= allVisitors.length %> entri</div>
            <div id="visitorPagination"></div>
            <!-- Tombol Detail -->
<button class="btn btn-sm btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#detailModal">
  Detail
</button>

<!-- Modal Detail -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="detailModalLabel">Detail Semua Visitor</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-sm">
            <thead class="table-light">
              <tr>
                <th>No</th>
                <th>Nama</th>
                <th>Keperluan</th>
                <th>Waktu</th>
                <th>Status</th>
                <th>Aksi</th> <!-- Tambahkan kolom aksi di modal -->
              </tr>
            </thead>
            <tbody>
              <% allVisitors.forEach((v, i) => { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><%= v.name %></td>
                  <td><%= v.purpose %></td>
                  <td><%= new Date(v.date).toLocaleString("id-ID") %></td>
                  <td>
                    <span class="px-2 py-1 rounded-full text-xs font-semibold
                      <%= v.status === 'approved' ? 'bg-green-200 text-green-800' 
                        : v.status === 'rejected' ? 'bg-red-200 text-red-800' 
                        : v.status === 'reschedule' ? 'bg-blue-200 text-blue-800' 
                        : 'bg-yellow-200 text-yellow-800' %>">
                      <%= v.status || 'pending' %>
                    </span>
                  </td>
                  <td>
                    <!-- Tombol aksi CRUD hanya di modal -->
                    <a href="/visitor/edit/<%= v._id %>" class="btn btn-sm btn-warning me-1"><i class="bi bi-pencil"></i></a>
                    <form action="/visitor/delete/<%= v._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Yakin hapus data ini?')">
                      <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
      </div>
    </div>
  </div>
</div>


          </div>
        </div>
      </div>
      
      <!-- Tabel Paket -->
<div class="col-lg-6">
  <div class="table-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5><i class="bi bi-box-seam me-2"></i> Semua Paket</h5>
      <div class="input-group" style="width: 200px;">
        <input type="text" id="searchPackageInput" class="form-control form-control-sm search-box package" placeholder="Cari paket...">
        <button class="btn btn-sm btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
      </div>
    </div>

    <div class="table-responsive">
      <table id="packageTable" class="table table-hover">
        <thead class="table-light">
          <tr>
            <th>No</th>
            <th>No Resi</th>
            <th>Nama Kurir</th>
            <th>Penerima Paket</th>
            <th>Waktu</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="packageTableBody">
          <% if (allPackages.length === 0) { %>
            <tr><td colspan="6" class="text-center py-4">Belum ada paket.</td></tr>
          <% } else { %>
            <% allPackages.forEach((p, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= p.nomorResi %></td>
                <td><%= p.namaKurir %></td>
                <td><strong><%= p.penerimaNama %></strong></td>
                <td><%= p.createdAt ? new Date(p.createdAt).toLocaleString("id-ID") : '-' %></td>
                <td>
                  <span class="badge badge-pending"><i class="bi bi-box-seam me-1"></i> Belum diambil</span>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Tombol Detail + Pagination -->
    <!-- Tabel Paket: Info + Pagination + Tombol Detail -->
<div class="d-flex justify-content-between align-items-center mt-3">
  <!-- Kiri: Info entri -->
  <div>Menampilkan <%= Math.min(5, allPackages.length) %> dari <%= allPackages.length %> entri</div>

  <!-- Tengah: Pagination -->
  <div class="d-flex justify-content-center flex-grow-1">
    <div id="packagePagination"></div>
  </div>

  <!-- Kanan: Tombol Detail -->
  <div>
    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#detailPackageModal">
      Detail
    </button>
  </div>
</div>
  </div>
  <!-- Modal Detail Paket -->
<div class="modal fade" id="detailPackageModal" tabindex="-1" aria-labelledby="detailPackageModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="detailPackageModalLabel">Detail Semua Paket</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped table-sm">
            <thead class="table-light">
              <tr>
                <th>No</th>
                <th>No Resi</th>
                <th>Nama Kurir</th>
                <th>Penerima Paket</th>
                <th>Waktu</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% allPackages.forEach((p, i) => { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><%= p.nomorResi %></td>
                  <td><%= p.namaKurir %></td>
                  <td><%= p.penerimaNama %></td>
                  <td><%= p.createdAt ? new Date(p.createdAt).toLocaleString("id-ID") : '-' %></td>
                  <td>
                    <span class="badge badge-pending"><i class="bi bi-box-seam me-1"></i> Belum diambil</span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Edit Visitor -->
<div class="modal fade" id="editVisitorModal" tabindex="-1" aria-labelledby="editVisitorModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form id="editVisitorForm">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editVisitorModalLabel">Edit Visitor</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editVisitorId" name="id">
          <div class="mb-3">
            <label for="editVisitorName" class="form-label">Nama</label>
            <input type="text" class="form-control" id="editVisitorName" name="name" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorNik" class="form-label">NIK</label>
            <input type="text" class="form-control" id="editVisitorNik" name="nik" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorEmail" class="form-label">Email</label>
            <input type="email" class="form-control" id="editVisitorEmail" name="email" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorInstansi" class="form-label">Instansi</label>
            <input type="text" class="form-control" id="editVisitorInstansi" name="instansi" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorBertemu" class="form-label">Pegawai yang ingin ditemui</label>
            <input type="text" class="form-control" id="editVisitorBertemu" name="bertemu" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorJanji" class="form-label">Janji</label>
            <select class="form-select" id="editVisitorJanji" name="janji" required>
              <option value="ya">Ya</option>
              <option value="tidak">Tidak</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="editVisitorPurpose" class="form-label">Keperluan</label>
            <input type="text" class="form-control" id="editVisitorPurpose" name="purpose" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorRekan" class="form-label">Jumlah Tamu</label>
            <input type="text" class="form-control" id="editVisitorRekan" name="rekan" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorTanggal" class="form-label">Tanggal Kunjungan</label>
            <input type="date" class="form-control" id="editVisitorTanggal" name="tanggal" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorJam" class="form-label">Jam Kunjungan</label>
            <input type="time" class="form-control" id="editVisitorJam" name="jam" required>
          </div>
          <div class="mb-3">
            <label for="editVisitorStatus" class="form-label">Status</label>
            <select class="form-select" id="editVisitorStatus" name="status">
              <option value="pending">Pending</option>
              <option value="approved">Approved</option>
              <option value="rejected">Rejected</option>
              <option value="reschedule">Reschedule</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Simpan</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        </div>
      </div>
    </form>
  </div>
</div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    // Update current date and time
    function updateDateTime() {
      const now = new Date();
      document.getElementById('current-date').textContent = now.toLocaleDateString('id-ID', { 
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' 
      });
      document.getElementById('current-time').textContent = now.toLocaleTimeString('id-ID');
    }
    setInterval(updateDateTime, 1000);
    updateDateTime();

    // Visitor Chart
    const visitorCtx = document.getElementById('visitorChart').getContext('2d');
    const visitorChart = new Chart(visitorCtx, {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(chartLabels) %>,
        datasets: [{
          label: 'Jumlah Visitor',
          data: <%- JSON.stringify(chartData) %>,
          borderColor: 'rgba(52, 152, 219, 1)',
          backgroundColor: 'rgba(52, 152, 219, 0.1)',
          borderWidth: 2,
          fill: true,
          tension: 0.3
        }]
