  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    // ================= SCRIPT UPDATE WAKTU REALTIME =================
    function updateDateTime() {
      const now = new Date();
      document.getElementById('current-date').textContent = now.toLocaleDateString('id-ID', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
      });
      document.getElementById('current-time').textContent = now.toLocaleTimeString('id-ID');
    }
    setInterval(updateDateTime, 1000);
    updateDateTime();

    // ================= SCRIPT TRIGGER MODAL PILIHAN TAMU/PAKET =================
    document.getElementById('btnTambahVisitor').addEventListener('click', function () {
      var modal = new bootstrap.Modal(document.getElementById('modalPilihForm'));
      modal.show();
    });

    // ================= SCRIPT GRAFIK UTAMA APEXCHARTS =================

    // Konfigurasi Area Chart Trend Kunjungan Mingguan
    var trendOptions = {
      series: [{
        name: 'Visitor',
        data: <%- JSON.stringify(chartData) %>
      }, {
        name: 'Paket',
        data: <%- JSON.stringify(packageChartData) %>
      }],
      chart: {
        height: 280,
        type: 'area',
        background: 'transparent',
        fontFamily: 'Plus Jakarta Sans, sans-serif',
        toolbar: { show: false },
        sparkline: { enabled: false }
      },
      theme: { mode: 'light' },
      colors: ['#1e3a8a', '#5ca82f'],
      dataLabels: { enabled: false },
      stroke: { curve: 'smooth', width: 2.5 },
      fill: {
        type: 'gradient',
        gradient: {
          shadeIntensity: 1,
          opacityFrom: 0.25,
          opacityTo: 0,
          stops: [0, 95, 100]
        }
      },
      grid: {
        borderColor: '#e2e8f0',
        strokeDashArray: 4,
        xaxis: { lines: { show: false } },
        yaxis: { lines: { show: true } }
      },
      xaxis: {
        categories: <%- JSON.stringify(chartLabels.map(l => {
          const d = new Date(l);
          return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
        })) %>,
        axisBorder: { show: false },
        axisTicks: { show: false },
        labels: { style: { colors: '#64748b', fontSize: '9px' } }
      },
      yaxis: {
        labels: { style: { colors: '#64748b', fontSize: '9px' } }
      },
      tooltip: {
        theme: 'dark',
        x: { show: true }
      }
    };
    var trendChart = new ApexCharts(document.querySelector("#main-trend-chart"), trendOptions);
    trendChart.render();

    // ================= SCRIPT DONUT CHART STATUS KUNJUNGAN =================
    const visitorsList = <%- JSON.stringify(allVisitors) %>;
    const statusCounts = { approved: 0, pending: 0, checkedIn: 0, reschedule: 0, rejected: 0 };
    visitorsList.forEach(v => {
      const s = (v.status || '').toLowerCase();
      if (s === 'approved') statusCounts.approved++;
      else if (s === 'checked-in') statusCounts.checkedIn++;
      else if (s === 'reschedule') statusCounts.reschedule++;
      else if (s === 'rejected') statusCounts.rejected++;
      else statusCounts.pending++;
    });

    var statusOptions = {
      series: [statusCounts.approved, statusCounts.pending, statusCounts.checkedIn, statusCounts.reschedule, statusCounts.rejected],
      chart: {
        type: 'donut',
        height: 180,
        fontFamily: 'Plus Jakarta Sans, sans-serif'
      },
      labels: ['Approved', 'Pending', 'Checked-in', 'Reschedule', 'Rejected'],
      colors: ['#10b981', '#f59e0b', '#3b82f6', '#8b5cf6', '#ef4444'],
      legend: { show: false },
      dataLabels: { enabled: false },
      plotOptions: {
        pie: {
          donut: {
            size: '72%',
            background: 'transparent',
            labels: {
              show: true,
              name: {
                show: true,
                fontSize: '10px',
                color: '#64748b',
                offsetY: -5
              },
              value: {
                show: true,
                fontSize: '18px',
                fontWeight: 'bold',
                color: '#1e293b',
                offsetY: 5,
                formatter: function (val) { return val; }
              },
              total: {
                show: true,
                label: 'Total',
                color: '#64748b',
                fontSize: '10px',
                formatter: function (w) {
                  return w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                }
              }
            }
          }
        }
      },
      stroke: { show: false },
      theme: { mode: 'light' }
    };
    var statusChart = new ApexCharts(document.querySelector("#visitor-status-chart"), statusOptions);
    statusChart.render();

    // ================= SCRIPT GRAFIK MINI SPARKLINE CARD =================
    var spark1Options = {
      series: [{ data: <%- JSON.stringify(chartData) %> }],
      chart: { type: 'line', width: 90, height: 35, sparkline: { enabled: true } },
      stroke: { curve: 'smooth', width: 2 },
      colors: ['#3b82f6'],
      tooltip: { enabled: false }
    };
    new ApexCharts(document.querySelector("#sparkline-visitor"), spark1Options).render();

    var spark2Options = {
      series: [{ data: <%- JSON.stringify(packageChartData) %> }],
      chart: { type: 'line', width: 90, height: 35, sparkline: { enabled: true } },
      stroke: { curve: 'smooth', width: 2 },
      colors: ['#10b981'],
      tooltip: { enabled: false }
    };
    new ApexCharts(document.querySelector("#sparkline-package"), spark2Options).render();

    var spark3Options = {
      series: [{ data: <%- JSON.stringify(chartData) %> }],
      chart: { type: 'line', width: 90, height: 35, sparkline: { enabled: true } },
      stroke: { curve: 'smooth', width: 2 },
      colors: ['#8b5cf6'],
      tooltip: { enabled: false }
    };
    new ApexCharts(document.querySelector("#sparkline-monthly-visitor"), spark3Options).render();

    var spark4Options = {
      series: [{ data: <%- JSON.stringify(packageChartData) %> }],
      chart: { type: 'line', width: 90, height: 35, sparkline: { enabled: true } },
      stroke: { curve: 'smooth', width: 2 },
      colors: ['#f59e0b'],
      tooltip: { enabled: false }
    };
    new ApexCharts(document.querySelector("#sparkline-monthly-package"), spark4Options).render();

    // ================= SCRIPT PAGINATION & SEARCH PREVIEW TABEL =================
    function setupPaginatedSearch(tableId, paginationId, searchInputId, itemsPerPage) {
      const table = document.getElementById(tableId);
      if (!table) return;
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const pagination = document.getElementById(paginationId);
      const searchInput = document.getElementById(searchInputId);

      let currentPage = 1;
      let filteredRows = rows;

      function showRows() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        rows.forEach(row => row.style.display = 'none');
        filteredRows.slice(start, end).forEach(row => row.style.display = '');
      }

      function renderPagination() {
        pagination.innerHTML = '';
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        if (totalPages <= 1) return;

        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.textContent = i;
          btn.className = 'w-5 h-5 rounded flex items-center justify-center text-[10px] transition-all ' +
            (i === currentPage
              ? 'bg-[#5ca82f] text-white font-bold'
              : 'bg-[#1e293b]/50 text-slate-600 hover:bg-slate-800 hover:text-slate-800');

          btn.onclick = () => {
            currentPage = i;
            showRows();
            renderPagination();
          };
          pagination.appendChild(btn);
        }
      }

      function filterRows() {
        const keyword = searchInput.value.toLowerCase();
        filteredRows = rows.filter(row =>
          row.innerText.toLowerCase().includes(keyword)
        );
        currentPage = 1;
        renderPagination();
        showRows();
      }

      if (searchInput) {
        searchInput.addEventListener('input', filterRows);
      }

      filterRows(); // Render pertama kali
    }

    // Inisialisasi pagination tabel preview (5 data per halaman)
    setupPaginatedSearch('visitorTable', 'visitorPagination', 'searchVisitorInput', 5);
    setupPaginatedSearch('packageTable', 'packagePagination', 'searchPackageInput', 5);

    // ================= SCRIPT GLOBAL SEARCH =================
    const globalSearch = document.getElementById('globalSearchInput');
    if (globalSearch) {
      globalSearch.addEventListener('input', function () {
        const val = this.value;
        const vSearch = document.getElementById('searchVisitorInput');
        const pSearch = document.getElementById('searchPackageInput');
        if (vSearch) {
          vSearch.value = val;
          vSearch.dispatchEvent(new Event('input'));
        }
        if (pSearch) {
          pSearch.value = val;
          pSearch.dispatchEvent(new Event('input'));
        }
      });
    }



    // ================= SCRIPT PARSING & TAMPIL MODAL EDIT VISITOR =================
    document.querySelectorAll('#detailModal .btn-warning').forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        const row = btn.closest('tr');
        const id = btn.getAttribute('href').split('/').pop();

        document.getElementById('editVisitorId').value = id;
        document.getElementById('editVisitorName').value = row.children[1].innerText;
        document.getElementById('editVisitorNik').value = row.children[2].innerText;
        document.getElementById('editVisitorPhone').value = row.children[3].innerText.trim() !== '-' ? row.children[3].innerText.trim() : '';
        document.getElementById('editVisitorEmail').value = row.children[4].innerText;
        document.getElementById('editVisitorInstansi').value = row.children[5].innerText !== '-' ? row.children[5].innerText : '';

        // Jenis Kunjungan (Category)
        const catText = row.children[6].innerText.trim();
        document.getElementById('editVisitorCategory').value = catText || 'Meeting';

        document.getElementById('editVisitorBertemu').value = row.children[7].innerText !== '-' ? row.children[7].innerText : '';
        document.getElementById('editVisitorJanji').value = row.children[8].innerText.toLowerCase();
        document.getElementById('editVisitorPurpose').value = row.children[9].innerText;
        document.getElementById('editVisitorRekan').value = row.children[10].innerText !== '-' ? row.children[10].innerText : '';

        // Parse tanggal dd/mm/yyyy ke format yyyy-mm-dd
        const rawDate = row.children[11].innerText;
        if (rawDate && rawDate !== '-') {
          const parts = rawDate.split('/');
          if (parts.length === 3) {
            document.getElementById('editVisitorTanggal').value = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
          }
        } else {
          document.getElementById('editVisitorTanggal').value = '';
        }

        document.getElementById('editVisitorJam').value = row.children[12].innerText !== '-' ? row.children[12].innerText : '';

        // Prioritas
        const prioText = row.children[14].innerText.trim();
        let prioVal = 'Normal';
        if (prioText.includes('Mendesak')) prioVal = 'Mendesak';
        else if (prioText.includes('Penting')) prioVal = 'Penting';
        document.getElementById('editVisitorPriority').value = prioVal;

        document.getElementById('editVisitorStatus').value = row.children[15].innerText.trim().toLowerCase();

        // Sembunyikan modal detail, lalu tampilkan modal edit
        var detailModal = bootstrap.Modal.getInstance(document.getElementById('detailModal'));
        if (detailModal) detailModal.hide();

        var modal = new bootstrap.Modal(document.getElementById('editVisitorModal'));
        modal.show();
      });
    });

    // ================= SCRIPT PARSING & TAMPIL MODAL EDIT PAKET =================
    document.querySelectorAll('#detailPackageModal .btn-edit-package').forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        const row = btn.closest('tr');
        const id = btn.getAttribute('href').split('/').pop();

        document.getElementById('editPackageId').value = id;
        document.getElementById('editNomorResi').value = row.children[1].innerText;
        document.getElementById('editJenisPaket').value = row.children[2].innerText !== '-' ? row.children[2].innerText : '';
        document.getElementById('editDeskripsiPaket').value = row.children[3].innerText !== '-' ? row.children[3].innerText : '';
        document.getElementById('editNamaKurir').value = row.children[4].innerText;
        document.getElementById('editPenerimaNama').value = row.children[8].innerText !== '-' ? row.children[8].innerText : '';

        // Sembunyikan modal detail, lalu tampilkan modal edit
        var detailModal = bootstrap.Modal.getInstance(document.getElementById('detailPackageModal'));
        if (detailModal) detailModal.hide();

        var modal = new bootstrap.Modal(document.getElementById('editPackageModal'));
        modal.show();
      });
    });

    // ================= SCRIPT SUBMIT EDIT FORM VIA AJAX =================
    document.getElementById('editVisitorForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const id = document.getElementById('editVisitorId').value;
      const data = {
        name: document.getElementById('editVisitorName').value,
        nik: document.getElementById('editVisitorNik').value,
        email: document.getElementById('editVisitorEmail').value,
        nomorHp: document.getElementById('editVisitorPhone').value,
        instansi: document.getElementById('editVisitorInstansi').value,
        bertemu: document.getElementById('editVisitorBertemu').value,
        janji: document.getElementById('editVisitorJanji').value,
        jenisKunjungan: document.getElementById('editVisitorCategory').value,
        prioritas: document.getElementById('editVisitorPriority').value,
        purpose: document.getElementById('editVisitorPurpose').value,
        rekan: document.getElementById('editVisitorRekan').value,
        tanggal: document.getElementById('editVisitorTanggal').value,
        jam: document.getElementById('editVisitorJam').value,
        status: document.getElementById('editVisitorStatus').value
      };

      fetch(`/visitor/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
        .then(res => res.json())
        .then(resData => {
          if (resData.success) {
            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: 'Data visitor berhasil diperbarui.',
              confirmButtonColor: '#3b82f6'
            }).then(() => location.reload());
          } else {
            Swal.fire('Gagal!', 'Gagal update data visitor: ' + (resData.error || ''), 'error');
          }
        });
    });

    document.getElementById('editPackageForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const id = document.getElementById('editPackageId').value;
      const data = {
        nomorResi: document.getElementById('editNomorResi').value,
        namaKurir: document.getElementById('editNamaKurir').value,
        penerimaNama: document.getElementById('editPenerimaNama').value,
        deskripsiPaket: document.getElementById('editDeskripsiPaket').value,
        jenisPaket: document.getElementById('editJenisPaket').value
      };

      fetch(`/package/edit/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
        .then(res => res.json())
        .then(resData => {
          if (resData.success) {
            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: 'Data paket berhasil diperbarui.',
              confirmButtonColor: '#3b82f6'
            }).then(() => location.reload());
          } else {
            Swal.fire('Gagal!', 'Gagal update data paket: ' + (resData.error || ''), 'error');
          }
        });
    });

    // ================= SCRIPT HAPUS DATA VIA AJAX (SWEETALERT2) =================
    document.querySelectorAll('#detailModal .form-delete-visitor').forEach(form => {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        Swal.fire({
          title: 'Yakin hapus data ini?',
          text: 'Data yang dihapus tidak dapat dikembalikan!',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#ef4444',
          cancelButtonColor: '#475569',
          confirmButtonText: 'Ya, hapus!',
          cancelButtonText: 'Batal'
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(form.action, { method: 'POST' })
              .then(res => res.json())
              .then(resData => {
                if (resData.success) {
                  Swal.fire('Terhapus!', 'Data berhasil dihapus.', 'success')
                    .then(() => location.reload());
                } else {
                  Swal.fire('Gagal!', 'Gagal menghapus data.', 'error');
                }
              });
          }
        });
      });
    });

    document.querySelectorAll('#detailPackageModal .form-delete-package').forEach(form => {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        Swal.fire({
          title: 'Yakin hapus data paket ini?',
          text: 'Data yang dihapus tidak dapat dikembalikan!',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#ef4444',
          cancelButtonColor: '#475569',
          confirmButtonText: 'Ya, hapus!',
          cancelButtonText: 'Batal'
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(form.action, { method: 'POST' })
              .then(res => res.json())
              .then(resData => {
                if (resData.success) {
                  Swal.fire('Terhapus!', 'Data paket berhasil dihapus.', 'success')
                    .then(() => location.reload());
                } else {
                  Swal.fire('Gagal!', 'Gagal menghapus data paket.', 'error');
                }
              });
          }
        });
      });
    });
  </script>
</body>

</html>