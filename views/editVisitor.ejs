<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Edit Visitor - BPMA GateLog</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter&display=swap');
      body {
        font-family: 'Inter', sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-cover bg-center" style="background-image: url('/images/bg-plant.jpg');">
    <div class="min-h-screen w-full bg-white/80 backdrop-blur-sm flex items-center justify-center p-6">
      <div class="max-w-xl w-full flex flex-col items-center justify-center py-8">
        
        <!-- Form Section -->
        <form id="editVisitorForm" class="bg-white rounded-2xl shadow-2xl border border-slate-100 p-8 w-full space-y-4" onsubmit="return submitForm(event)">
          <div class="flex justify-between items-center pb-2 border-b border-slate-100">
            <h2 class="text-xl font-bold text-[#1e3a8a]">Edit Data Kunjungan</h2>
            <a href="/" class="text-xs text-slate-500 hover:text-[#1e3a8a] flex items-center gap-1">
              <i class="fas fa-arrow-left"></i> Kembali ke Dashboard
            </a>
          </div>

          <div>
            <label for="name" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Nama Tamu</label>
            <input id="name" name="name" type="text" value="<%= visitor.name %>" required class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" />
          </div>

          <div>
            <label for="nik" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">NIK Tamu</label>
            <input id="nik" name="nik" type="text" value="<%= visitor.nik %>" maxlength="16" minlength="16" required class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" />
            <small class="text-red-500 text-xs mt-1 hidden" id="nikError">NIK harus terdiri dari 16 digit angka.</small>
          </div>

          <div>
            <label for="email" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Email Tamu</label>
            <input id="email" name="email" type="email" value="<%= visitor.email %>" required class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" />
            <small class="text-red-500 text-xs mt-1 hidden" id="emailError">Format email harus valid.</small>
          </div>

          <div>
            <label for="phoneNumber" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Nomor HP Tamu</label>
            <input id="phoneNumber" name="phoneNumber" type="tel" value="<%= visitor.phoneNumber || '' %>" required class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" />
            <small class="text-red-500 text-xs mt-1 hidden" id="phoneError">Nomor HP harus terdiri dari 10-14 digit angka.</small>
          </div>

          <div>
            <label for="institution" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Asal Instansi</label>
            <input list="instansiList" id="institution" name="institution" type="text" value="<%= visitor.institution || visitor.instansi || '' %>" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required />
            <datalist id="instansiList">
              <option value="PT Pertamina"></option>
              <option value="PT Medco E&P"></option>
              <option value="Universitas Syiah Kuala"></option>
              <option value="BPMA (Badan Pengelola Migas Aceh)"></option>
              <option value="Pemerintah Aceh"></option>
              <option value="Kementerian ESDM"></option>
              <option value="SKK Migas"></option>
              <option value="Swasta"></option>
              <option value="Lainnya"></option>
            </datalist>
          </div>

          <div>
            <label for="targetEmployee" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Pegawai yang ingin ditemui</label>
            <input list="employeeList" id="targetEmployee" name="targetEmployee" value="<%= visitor.targetEmployee || visitor.bertemu %>" placeholder="Ketik nama pegawai..." class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required />
            <datalist id="employeeList">
              <% employees.forEach(emp => { %>
                <option value="<%= emp.name %> - <%= emp.position %>"></option>
              <% }) %>
            </datalist>
          </div>

          <div>
            <label for="hasAppointment" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Apakah sudah membuat janji?</label>
            <select id="hasAppointment" name="hasAppointment" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required>
              <option value="ya" <%= visitor.hasAppointment === 'ya' ? 'selected' : '' %>>Ya</option>
              <option value="tidak" <%= visitor.hasAppointment === 'tidak' ? 'selected' : '' %>>Tidak</option>
            </select>
          </div>

          <div>
            <label for="purpose" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Keperluan</label>
            <input id="purpose" name="purpose" type="text" value="<%= visitor.purpose %>" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required />
          </div>

          <div>
            <label for="visitCategory" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Jenis Kunjungan</label>
            <select id="visitCategory" name="visitCategory" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required>
              <option value="Meeting" <%= visitor.visitCategory === 'Meeting' ? 'selected' : '' %>>Meeting</option>
              <option value="Konsultasi" <%= visitor.visitCategory === 'Konsultasi' ? 'selected' : '' %>>Konsultasi</option>
              <option value="Vendor" <%= visitor.visitCategory === 'Vendor' ? 'selected' : '' %>>Vendor</option>
              <option value="Pengiriman Dokumen" <%= visitor.visitCategory === 'Pengiriman Dokumen' ? 'selected' : '' %>>Pengiriman Dokumen</option>
              <option value="Interview" <%= visitor.visitCategory === 'Interview' ? 'selected' : '' %>>Interview</option>
              <option value="Maintenance" <%= visitor.visitCategory === 'Maintenance' ? 'selected' : '' %>>Maintenance</option>
              <option value="Audit" <%= visitor.visitCategory === 'Audit' ? 'selected' : '' %>>Audit</option>
              <option value="Lainnya" <%= visitor.visitCategory === 'Lainnya' ? 'selected' : '' %>>Lainnya</option>
            </select>
          </div>

          <div>
            <label class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-2">Prioritas Kunjungan</label>
            <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-lg border border-slate-200">
              <label class="inline-flex items-center cursor-pointer">
                <input type="radio" name="priority" value="Normal" <%= visitor.priority === 'Normal' ? 'checked' : '' %> class="form-radio text-[#5ca82f] focus:ring-[#5ca82f] w-4 h-4" />
                <span class="ml-1 text-xs font-semibold text-slate-700">🟢 Normal</span>
              </label>
              <label class="inline-flex items-center cursor-pointer">
                <input type="radio" name="priority" value="Penting" <%= visitor.priority === 'Penting' ? 'checked' : '' %> class="form-radio text-amber-500 focus:ring-amber-500 w-4 h-4" />
                <span class="ml-1 text-xs font-semibold text-slate-700">🟡 Penting</span>
              </label>
              <label class="inline-flex items-center cursor-pointer">
                <input type="radio" name="priority" value="Mendesak" <%= visitor.priority === 'Mendesak' ? 'checked' : '' %> class="form-radio text-rose-600 focus:ring-rose-500 w-4 h-4" />
                <span class="ml-1 text-xs font-semibold text-slate-700">🔴 Mendesak</span>
              </label>
            </div>
          </div>

          <div>
            <label for="companions" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Jumlah Tamu</label>
            <select id="companions" name="companions" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required>
              <option value="0" <%= visitor.companions === 0 ? 'selected' : '' %>>0 (Sendiri)</option>
              <option value="1" <%= visitor.companions === 1 ? 'selected' : '' %>>1 Orang</option>
              <option value="2" <%= visitor.companions === 2 ? 'selected' : '' %>>2 Orang</option>
              <option value="3" <%= visitor.companions === 3 ? 'selected' : '' %>>3 Orang</option>
              <option value="4" <%= visitor.companions === 4 ? 'selected' : '' %>>4 Orang</option>
              <option value="5" <%= visitor.companions >= 5 ? 'selected' : '' %>>5+ Orang</option>
            </select>
          </div>

          <%
            let formattedDate = '';
            if (visitor.schedule) {
              const d = new Date(visitor.schedule);
              const year = d.getFullYear();
              const month = String(d.getMonth() + 1).padStart(2, '0');
              const day = String(d.getDate()).padStart(2, '0');
              formattedDate = `${year}-${month}-${day}`;
            }
          %>
          <div>
            <label for="schedule" class="block text-slate-700 font-semibold text-xs uppercase tracking-wider mb-1">Tanggal Kunjungan</label>
            <input id="schedule" name="schedule" type="date" value="<%= formattedDate %>" class="w-full rounded-lg text-sm px-3.5 py-2 bg-slate-50 text-slate-900 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] focus:bg-white transition-all" required />
          </div>

          <button type="submit" class="w-full bg-[#5ca82f] hover:bg-[#4d8b26] text-white font-bold text-sm py-3 rounded-lg shadow-md hover:shadow-lg transition-all mt-4">
            Simpan Perubahan
          </button>
        </form>
      </div>
    </div>

    <script>
      async function submitForm(event) {
        event.preventDefault();

        // Validasi manual NIK, Email, & Nomor HP
        const nikInput = document.getElementById('nik');
        const emailInput = document.getElementById('email');
        const phoneInput = document.getElementById('phoneNumber');
        const nikError = document.getElementById('nikError');
        const emailError = document.getElementById('emailError');
        const phoneError = document.getElementById('phoneError');

        let isValid = true;
        nikError.classList.add('hidden');
        emailError.classList.add('hidden');
        phoneError.classList.add('hidden');

        const nik = nikInput.value.trim();
        if (!/^\d{16}$/.test(nik)) {
          nikError.classList.remove('hidden');
          isValid = false;
        }

        const email = emailInput.value.trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          emailError.classList.remove('hidden');
          isValid = false;
        }

        const phone = phoneInput.value.trim();
        if (!/^\d{10,14}$/.test(phone)) {
          phoneError.classList.remove('hidden');
          isValid = false;
        }

        if (!isValid) return false;

        const form = document.getElementById('editVisitorForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.companions = Number(data.companions);

        // Map schedule string to full date
        data.schedule = new Date(data.schedule);

        try {
          const response = await fetch('/visitor/edit/<%= visitor._id %>', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();
          if (response.ok && result.success) {
            Swal.fire({
              icon: 'success',
              title: 'Berhasil!',
              text: 'Data visitor berhasil diperbarui.',
              confirmButtonColor: '#5ca82f'
            }).then(() => {
              window.location.href = '/';
            });
          } else {
            Swal.fire({ icon: 'error', title: 'Gagal!', text: result.error || 'Terjadi kesalahan.' });
          }
        } catch (err) {
          Swal.fire({ icon: 'error', title: 'Error!', text: 'Gagal menghubungi server.' });
        }

        return false;
      }
    </script>
  </body>
</html>
