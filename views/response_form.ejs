<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= action === 'reject' ? 'Konfirmasi Penolakan Pertemuan' : 'Usulan Jadwal Ulang Pertemuan' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="flex items-center justify-center min-h-screen bg-slate-50 p-4 sm:p-6">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border border-slate-100 transition-all duration-300 hover:shadow-2xl">
    <!-- Header Decorator -->
    <div class="<%= action === 'reject' ? 'bg-gradient-to-r from-red-500 to-rose-600' : 'bg-gradient-to-r from-blue-500 to-indigo-600' %> p-6 text-white text-center">
      <div class="text-4xl mb-2">
        <%= action === 'reject' ? '❌' : '📆' %>
      </div>
      <h1 class="text-xl font-bold tracking-tight">
        <%= action === 'reject' ? 'Formulir Penolakan Kunjungan' : 'Usulan Penjadwalan Ulang' %>
      </h1>
      <p class="text-sm opacity-90 mt-1">Silakan berikan keterangan untuk menginformasikan visitor.</p>
    </div>

    <div class="p-6 sm:p-8 space-y-6">
      <!-- Visitor Info Card -->
      <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 space-y-3">
        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Detail Permintaan</h3>
        <div class="grid grid-cols-3 gap-2 text-sm text-slate-700">
          <span class="font-medium text-slate-500">Nama</span>
          <span class="col-span-2 font-semibold text-slate-800"><%= visitor.name %></span>

          <span class="font-medium text-slate-500">Instansi</span>
          <span class="col-span-2"><%= visitor.institution %></span>

          <span class="font-medium text-slate-500">Keperluan</span>
          <span class="col-span-2 text-slate-600 italic">"<%= visitor.purpose %>"</span>

          <span class="font-medium text-slate-500">Jadwal</span>
          <span class="col-span-2 font-medium text-slate-700"><%= new Date(visitor.schedule).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
        </div>
      </div>

      <!-- Action Form -->
      <form action="/response/<%= action === 'reject' ? 'rejected' : 'reschedule' %>/<%= visitor._id %>" method="POST" class="space-y-4">
        <div>
          <label for="employeeNotes" class="block text-sm font-semibold text-slate-700 mb-2">
            <%= action === 'reject' ? 'Alasan Penolakan' : 'Keterangan Penjadwalan Ulang' %> <span class="text-red-500">*</span>
          </label>
          <textarea 
            id="employeeNotes" 
            name="employeeNotes" 
            rows="4" 
            required
            placeholder="<%= action === 'reject' ? 'Contoh: Mohon maaf, saya sedang dinas luar kota pada waktu tersebut.' : 'Contoh: Mohon dijadwalkan ulang pada hari esok pukul 10:00 WIB. Terima kasih.' %>"
            class="w-full rounded-xl border border-slate-200 p-3 text-sm focus:outline-none focus:ring-2 <%= action === 'reject' ? 'focus:ring-red-500 focus:border-red-500' : 'focus:ring-blue-500 focus:border-blue-500' %> transition-all placeholder:text-slate-400"
          ></textarea>
        </div>

        <div class="flex items-center space-x-3 pt-2">
          <a href="javascript:history.back()" class="w-1/3 bg-slate-100 hover:bg-slate-200 text-slate-700 py-3 rounded-xl text-center text-sm font-medium transition-colors">
            Kembali
          </a>
          <button 
            type="submit" 
            class="w-2/3 <%= action === 'reject' ? 'bg-red-600 hover:bg-red-700 shadow-red-200' : 'bg-blue-600 hover:bg-blue-700 shadow-blue-200' %> text-white py-3 rounded-xl text-sm font-semibold shadow-lg hover:shadow-xl transition-all active:scale-[0.98]"
          >
            Kirim Respon
          </button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
