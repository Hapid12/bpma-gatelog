<%- include('partials/header', { currentPath: request.url }) %>


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Data Paket - BPMA GateLog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">

</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="mb-4 text-center">Form Data Paket Masuk</h1>

    <!-- Form Input -->
    <div class="card mb-5 shadow-sm">
      <div class="card-body">
        <form method="POST" action="/package/add">
          <div class="mb-3">
            <label class="form-label">Nama Penerima</label>
            <input type="text" name="recipient" class="form-control" placeholder="Masukkan nama penerima" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Nama Kurir</label>
            <input type="text" name="courier" class="form-control" placeholder="Masukkan nama kurir" required>
          </div>
          <button type="submit" class="btn btn-success">Simpan Paket</button>
        </form>
      </div>
    </div>

    <!-- Tabel Riwayat Paket -->
    <h2 class="mb-3">Riwayat Paket Masuk</h2>
    <div class="table-responsive shadow-sm">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>No</th>
                <th>Penerima</th>
                <th>Kurir</th>
                <th>Tanggal</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            <% if (packages.length === 0) { %>
            <tr>
            <td colspan="5" class="text-center">Belum ada data paket.</td>
            </tr>
            <% } else { %>
            <% packages.forEach((pkg, index) => { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><%= pkg.recipient %></td>
                <td><%= pkg.courier %></td>
                <td><%= new Date(pkg.date).toLocaleDateString("id-ID") %></td>
                <td>
                    <a href="/package/edit/<%= pkg._id %>" class="btn btn-sm btn-warning">Edit</a>
                    <form action="/package/delete/<%= pkg._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Hapus data paket ini?')">Hapus</button>
                    </form>
                </td>
            </tr>
            <% }) %>
            <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
