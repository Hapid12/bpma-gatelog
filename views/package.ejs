<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>GateLog BPMA Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter&display=swap');
      body {
        font-family: 'Inter', Poppins;
      }
    </style>
  </head>
  <body class="bg-[#f7f8f8] min-h-screen flex items-center justify-center p-6">
    <div class="max-w-7xl w-full flex flex-col md:flex-row items-center md:items-start justify-center gap-12">
      
      <!-- Left Section (Informasi) -->
      <div class="flex flex-col max-w-xl w-full md:w-1/2 text-center md:text-left">
        <div class="flex justify-center md:justify-start mb-6">
          <img alt="BPMA Logo" src="/logoBPMA.png" width="165" class="mb-28" />
        </div>
        <h1 class="text-4xl font-extrabold leading-tight mb-3">
          PackageLog BPMA<br/>Sistem Mencatat Paket
        </h1>
        <p class="text-sm text-black/90 max-w-md mx-auto md:mx-0">
          Sebuah sistem web untuk mencatat dan melacak paket yang masuk ke kantor.
          Menyediakan fitur pencatatan real-time, pencarian cepat, dan konfirmasi penerimaan oleh pegawai.
        </p>
      </div>

    <!-- Form -->
    <form action="/visitor" method="POST" class="bg-[#3a3a3a] rounded-lg p-6 w-full max-w-md space-y-4">
          <!-- Informasi Paket -->
          <div>
            <h2 class="text-lg font-bold mb-6 block text-white border-b pb-2">Informasi Paket</h2>
            <div class="mb-4">
              <label for="nomorResi" class="block text-white font-medium text-sm mb-1">Nomor Resi</label>
              <input id="nomorResi" name="nomorResi" type="text" required class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label for="tipePaket" class="block text-white font-medium text-sm mb-1">Jenis Paket</label>
              <input id="tipePaket" name="tipePaket" type="text" required class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
              <label for="deskripsiPaket" class="block text-white font-medium text-sm mb-1">Deskripsi Paket (Opsional)</label>
              <textarea id="deskripsiPaket" name="deskripsiPaket" rows="3" class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
          </div>

          <!-- Informasi Kurir -->
          <div>
            <h2 class="text-lg font-bold mb-6 block text-white border-b pb-2">Informasi Kurir</h2>
            <div class="mb-4">
              <label for="namaKurir" class="block text-white font-medium text-sm mb-1">Nama Kurir</label>
              <input id="namaKurir" name="namaKurir" type="text" required class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label for="emailKurir" class="block text-white font-medium text-sm mb-1">Email Kurir</label>
              <input id="emailKurir" name="emailKurir" type="email" required class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label for="nomorHpKurir" class="block text-white font-medium text-sm mb-1">Nomor HP Kurir</label>
              <input id="nomorHpKurir" name="nomorHpKurir" type="text" required class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label for="pengirim" class="block text-white font-medium text-sm mb-1">Pengirim</label>
              <input id="pengirim" name="pengirim" type="text" required class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
          </div>

          <!-- Tujuan Paket / Penerima -->
          <div>
            <h2 class="text-lg font-bold mb-6 block text-white border-b pb-2">Penerima Paket</h2>
            <label for="tujuanPaket" class="block text-white font-medium text-sm mb-1">Pilih Karyawan</label>
            <select id="tujuanPaket" name="tujuanPaket" required class="w-full px-4 py-2 bg-gray-50 text-gray-900 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="" disabled selected>Pilih Karyawan</option>
              <% employees.forEach(emp => { %>
                <option value="<%= emp._id %>"><%= emp.name %> - <%= emp.email %></option>
              <% }) %>
            </select>
          </div>

          <!-- Upload Foto Paket -->
          <div>
            <h2 class="text-lg font-bold mb-6 block text-white border-b pb-2">Upload Foto Paket</h2>
            <input id="fotoPaket" name="fotoPaket" type="file" accept="image/*" required class="block text-white font-medium text-sm mb-1 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700" />
          </div>

          <!-- Submit -->
          <div class="text-center pt-4">
            <button type="submit" class="w-full bg-[#5ca82f] text-white font-semibold text-xs py-2 rounded">
              Kirim
            </button>
          </div>
        </form>
      </div>
    </main>
        </div>
      </div>
    </div>
  </body>
</html>
