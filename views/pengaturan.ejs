<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pengaturan - BPMA GateLog</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] } } }
    }
  </script>
  <style>
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    .tab-btn.active { background: #1e3a8a; color: white; }
    .tab-btn { transition: all 0.2s; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .input-field {
      width: 100%; background: #f8fafc; border: 1px solid #e2e8f0;
      border-radius: 8px; padding: 9px 14px; font-size: 13px;
      color: #1e293b; outline: none; transition: border-color 0.2s;
    }
    .input-field:focus { border-color: #1e3a8a; box-shadow: 0 0 0 3px rgba(30,58,138,0.08); }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 antialiased overflow-hidden font-sans">
  <div class="flex h-screen w-screen overflow-hidden">

    <!-- ====== SIDEBAR ====== -->
    <aside class="w-64 bg-[#1e3a8a] border-r border-[#1e3a8a]/20 flex flex-col justify-between shrink-0 z-20">
      <div>
        <!-- Logo -->
        <div class="flex items-center px-6 py-5 border-b border-[#1e3a8a]/20">
          <svg class="w-8 h-8 mr-2.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3C12 3 6 8.5 6 13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13C18 8.5 12 3 12 3Z" fill="url(#lg1)"/>
            <path d="M12 8C12 8 9.5 11 9.5 13C9.5 14.3807 10.6193 15.5 12 15.5C13.3807 15.5 14.5 14.3807 14.5 13C14.5 11 12 8 12 8Z" fill="#FFFFFF"/>
            <defs><linearGradient id="lg1" x1="6" y1="3" x2="18" y2="19" gradientUnits="userSpaceOnUse"><stop stop-color="#10B981"/><stop stop-color="#059669"/></linearGradient></defs>
          </svg>
          <div class="flex flex-col">
            <span class="text-base font-bold tracking-wider text-white">BPMA</span>
            <span class="text-xs font-semibold tracking-wide text-[#5ca82f] -mt-1">GateLog</span>
          </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-4 space-y-1.5 py-6">
          <a href="/" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-grid-fill mr-3 text-base"></i><span>Dashboard</span>
          </a>
          <a href="/visitor" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-people mr-3 text-base"></i><span>Visitor</span>
          </a>
          <a href="/package" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-box-seam mr-3 text-base"></i><span>Paket Masuk</span>
          </a>
          <% if (user && user.role === 'admin') { %>
          <a href="/appointment" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-calendar-event mr-3 text-base"></i><span>Appointment</span>
          </a>
          <% } %>
          <a href="/approval" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-shield-check mr-3 text-base"></i><span>Approval</span>
          </a>
          <% if (user && user.role === 'admin') { %>
          <a href="/laporan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-file-earmark-text mr-3 text-base"></i><span>Laporan</span>
          </a>
          <a href="/audit-log" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-journal-code mr-3 text-base"></i><span>Audit Log</span>
          </a>
          <% } %>
          <!-- Pengaturan AKTIF -->
          <a href="/pengaturan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-[#5ca82f]/90 shadow-md shadow-[#5ca82f]/20 transition-all duration-200">
            <i class="bi bi-gear-fill mr-3 text-base"></i><span>Pengaturan</span>
          </a>
        </nav>
      </div>

      <!-- Profil + Logout -->
      <div class="p-4 border-t border-[#1e3a8a]/20">
        <a href="/logout" class="flex items-center justify-between p-2 rounded-lg hover:bg-rose-950/20 group cursor-pointer transition-colors duration-200">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white text-xs shadow-md">
              <%= user && user.name ? user.name[0].toUpperCase() : 'U' %>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-white"><%= user && user.name ? user.name : 'User' %></span>
              <span class="text-[10px] text-blue-200 capitalize">Role: <%= user && user.role ? user.role : 'Guest' %></span>
            </div>
          </div>
          <i class="bi bi-box-arrow-right text-blue-300 group-hover:text-rose-400 text-sm transition-colors"></i>
        </a>
      </div>
    </aside>

    <!-- ====== KONTEN KANAN ====== -->
    <div class="flex-1 flex flex-col overflow-hidden bg-slate-50">

      <!-- Topbar -->
      <header class="h-20 bg-white/90 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-8 z-10 shrink-0">
        <div>
          <h1 class="text-xl font-bold text-slate-800 tracking-wide">Pengaturan</h1>
          <p class="text-[11px] text-slate-500 mt-0.5">
            <%= (user && user.role === 'admin') ? 'Kelola karyawan, profil, dan konfigurasi sistem' : 'Kelola profil dan ganti password Anda' %>
          </p>
        </div>
        <div class="flex items-center space-x-3 text-xs text-slate-500">
          <i class="bi bi-gear text-[#1e3a8a] text-lg"></i>
          <span class="font-medium"><%= (user && user.role === 'admin') ? 'Admin Panel' : 'Satpam Panel' %></span>
        </div>
      </header>

      <!-- Flash Messages -->
      <% if (locals.error && error.length > 0) { %>
      <div class="mx-8 mt-4 bg-rose-50 border border-rose-200 text-rose-700 text-xs px-4 py-3 rounded-lg flex items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
      </div>
      <% } %>
      <% if (locals.success && success.length > 0) { %>
      <div class="mx-8 mt-4 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs px-4 py-3 rounded-lg flex items-center gap-2">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
      </div>
      <% } %>

      <!-- Main -->
      <main class="flex-1 overflow-y-auto p-8">

        <!-- Tab Navigation -->
        <% if (user && user.role === 'admin') { %>
        <div class="flex space-x-2 mb-6 bg-white border border-slate-200 rounded-xl p-1.5 w-fit shadow-sm">
          <button id="tab-karyawan" onclick="switchTab('karyawan')"
            class="tab-btn px-5 py-2 rounded-lg text-sm font-semibold text-slate-500 flex items-center gap-2 <%= activeTab === 'karyawan' ? 'active' : '' %>">
            <i class="bi bi-person-badge"></i> Manajemen Karyawan
          </button>
          <button id="tab-profil" onclick="switchTab('profil')"
            class="tab-btn px-5 py-2 rounded-lg text-sm font-semibold text-slate-500 flex items-center gap-2 <%= activeTab === 'profil' ? 'active' : '' %>">
            <i class="bi bi-shield-lock"></i> Profil & Password
          </button>
        </div>
        <% } %>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- TAB 1: MANAJEMEN KARYAWAN                          -->
        <!-- ═══════════════════════════════════════════════════ -->
        <% if (user && user.role === 'admin') { %>
        <div id="content-karyawan" class="tab-content <%= activeTab === 'karyawan' ? 'active' : '' %>">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Form Tambah Karyawan -->
            <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm h-fit">
              <h3 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
                <div class="w-6 h-6 bg-[#1e3a8a] rounded-md flex items-center justify-center">
                  <i class="bi bi-plus text-white text-sm"></i>
                </div>
                Tambah Karyawan Baru
              </h3>
              <form id="formTambahKaryawan" class="space-y-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Nama Lengkap *</label>
                  <input type="text" name="name" id="empName" class="input-field" placeholder="cth: Budi Santoso" required>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Email *</label>
                  <input type="email" name="email" id="empEmail" class="input-field" placeholder="cth: budi@gmail.com" required>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Jabatan</label>
                  <input type="text" name="position" id="empPosition" class="input-field" placeholder="cth: Kepala Bagian IT">
                </div>
                <button type="submit" class="w-full bg-[#1e3a8a] hover:bg-[#1e40af] text-white text-xs font-bold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
                  <i class="bi bi-plus-circle"></i> Tambah Karyawan
                </button>
              </form>
            </div>

            <!-- Tabel Daftar Karyawan -->
            <div class="lg:col-span-2 bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                  <div class="w-6 h-6 bg-emerald-500 rounded-md flex items-center justify-center">
                    <i class="bi bi-people text-white text-xs"></i>
                  </div>
                  Daftar Karyawan
                  <span id="empCount" class="bg-[#1e3a8a] text-white text-[10px] font-bold px-2 py-0.5 rounded-full ml-1"><%= employees.length %></span>
                </h3>
                <div class="relative w-44">
                  <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                  <input type="text" id="searchEmp" class="input-field pl-8 py-1.5 text-xs" placeholder="Cari karyawan...">
                </div>
              </div>

              <div class="overflow-x-auto">
                <table class="w-full text-[12px]" id="empTable">
                  <thead>
                    <tr class="border-b border-slate-200 text-slate-400 font-semibold uppercase text-[9px] tracking-wider">
                      <th class="pb-2 text-left">No</th>
                      <th class="pb-2 text-left">Nama</th>
                      <th class="pb-2 text-left">Email</th>
                      <th class="pb-2 text-left">Jabatan</th>
                      <th class="pb-2 text-center">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="empTableBody" class="divide-y divide-slate-100">
                    <% if (employees.length === 0) { %>
                    <tr>
                      <td colspan="5" class="text-center py-10 text-slate-400 text-xs">
                        <i class="bi bi-people text-3xl block mb-2"></i>
                        Belum ada karyawan terdaftar.
                      </td>
                    </tr>
                    <% } else { %>
                    <% employees.forEach((emp, i) => { %>
                    <tr class="hover:bg-slate-50 transition-colors" data-id="<%= emp._id %>" data-name="<%= emp.name %>" data-email="<%= emp.email %>" data-position="<%= emp.position || '' %>">
                      <td class="py-3 text-slate-400"><%= i + 1 %></td>
                      <td class="py-3">
                        <div class="flex items-center gap-2">
                          <div class="w-7 h-7 rounded-full bg-[#1e3a8a] flex items-center justify-center text-white text-[10px] font-bold shrink-0">
                            <%= emp.name ? emp.name[0].toUpperCase() : '?' %>
                          </div>
                          <span class="font-semibold text-slate-800"><%= emp.name %></span>
                        </div>
                      </td>
                      <td class="py-3 text-slate-500"><%= emp.email %></td>
                      <td class="py-3">
                        <span class="bg-slate-100 text-slate-600 text-[9px] font-semibold px-2 py-0.5 rounded-full"><%= emp.position || 'Staf' %></span>
                      </td>
                      <td class="py-3 text-center">
                        <div class="flex items-center justify-center gap-1.5">
                          <button onclick="openEditModal(this)" class="p-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-600 transition-colors" title="Edit">
                            <i class="bi bi-pencil text-xs"></i>
                          </button>
                          <button onclick="hapusKaryawan('<%= emp._id %>', '<%= emp.name %>')" class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors" title="Hapus">
                            <i class="bi bi-trash text-xs"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <% } %>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- TAB 2: PROFIL & PASSWORD                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <div id="content-profil" class="tab-content <%= activeTab === 'profil' ? 'active' : '' %>">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-3xl">

            <!-- Info Profil -->
            <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
              <h3 class="text-sm font-bold text-slate-800 mb-5 flex items-center gap-2">
                <div class="w-6 h-6 bg-purple-500 rounded-md flex items-center justify-center">
                  <i class="bi bi-person text-white text-xs"></i>
                </div>
                Informasi Akun
              </h3>

              <!-- Avatar -->
              <div class="flex items-center gap-4 mb-6 p-4 bg-slate-50 rounded-xl border border-slate-200">
                <div class="w-14 h-14 rounded-full bg-[#1e3a8a] flex items-center justify-center text-white text-2xl font-bold shadow-lg">
                  <%= user && user.name ? user.name[0].toUpperCase() : 'A' %>
                </div>
                <div>
                  <p class="font-bold text-slate-800 text-sm"><%= user && user.name ? user.name : '-' %></p>
                  <span class="inline-block mt-1 bg-[#1e3a8a] text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full capitalize">
                    <%= user && user.role ? user.role : 'Guest' %>
                  </span>
                </div>
              </div>

              <div class="space-y-3 text-xs">
                <div class="flex justify-between py-2 border-b border-slate-100">
                  <span class="text-slate-400 font-semibold uppercase tracking-wide">Username</span>
                  <span class="font-semibold text-slate-800 font-mono"><%= user && user.username ? user.username : '-' %></span>
                </div>
                <div class="flex justify-between py-2 border-b border-slate-100">
                  <span class="text-slate-400 font-semibold uppercase tracking-wide">Nama Lengkap</span>
                  <span class="font-semibold text-slate-800"><%= user && user.name ? user.name : '-' %></span>
                </div>
                <div class="flex justify-between py-2 border-b border-slate-100">
                  <span class="text-slate-400 font-semibold uppercase tracking-wide">Role</span>
                  <span class="font-semibold text-slate-800 capitalize"><%= user && user.role ? user.role : '-' %></span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-slate-400 font-semibold uppercase tracking-wide">Password</span>
                  <span class="text-slate-400">••••••••</span>
                </div>
              </div>
            </div>

            <!-- Form Ganti Password -->
            <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
              <h3 class="text-sm font-bold text-slate-800 mb-5 flex items-center gap-2">
                <div class="w-6 h-6 bg-amber-500 rounded-md flex items-center justify-center">
                  <i class="bi bi-shield-lock text-white text-xs"></i>
                </div>
                Ganti Password
              </h3>
              <form id="formGantiPassword" class="space-y-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Password Lama *</label>
                  <div class="relative">
                    <input type="password" name="passwordLama" id="pwLama" class="input-field pr-10" placeholder="Masukkan password saat ini" required>
                    <button type="button" onclick="togglePw('pwLama', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                      <i class="bi bi-eye text-sm"></i>
                    </button>
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Password Baru *</label>
                  <div class="relative">
                    <input type="password" name="passwordBaru" id="pwBaru" class="input-field pr-10" placeholder="Minimal 6 karakter" required>
                    <button type="button" onclick="togglePw('pwBaru', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                      <i class="bi bi-eye text-sm"></i>
                    </button>
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Konfirmasi Password Baru *</label>
                  <div class="relative">
                    <input type="password" name="konfirmasiPassword" id="pwKonfirmasi" class="input-field pr-10" placeholder="Ulangi password baru" required>
                    <button type="button" onclick="togglePw('pwKonfirmasi', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                      <i class="bi bi-eye text-sm"></i>
                    </button>
                  </div>
                </div>
                <!-- Password match indicator -->
                <p id="pwMatchMsg" class="text-[11px] hidden"></p>
                <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
                  <i class="bi bi-shield-check"></i> Perbarui Password
                </button>
              </form>
            </div>
          </div>
        </div>

      </main>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- MODAL EDIT KARYAWAN                                -->
  <!-- ═══════════════════════════════════════════════════ -->
  <% if (user && user.role === 'admin') { %>
  <div id="modalEdit" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
      <div class="flex justify-between items-center mb-5">
        <h4 class="font-bold text-slate-800 flex items-center gap-2">
          <i class="bi bi-pencil-square text-[#1e3a8a]"></i> Edit Karyawan
        </h4>
        <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 text-xl leading-none">&times;</button>
      </div>
      <form id="formEditKaryawan" class="space-y-4">
        <input type="hidden" id="editEmpId">
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Nama Lengkap *</label>
          <input type="text" id="editEmpName" class="input-field" required>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Email *</label>
          <input type="email" id="editEmpEmail" class="input-field" required>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Jabatan</label>
          <input type="text" id="editEmpPosition" class="input-field">
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="closeEditModal()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold py-2.5 rounded-lg transition-colors">
            Batal
          </button>
          <button type="submit" class="flex-1 bg-[#1e3a8a] hover:bg-[#1e40af] text-white text-xs font-bold py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
            <i class="bi bi-check-circle"></i> Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // ── Tab Switching ──────────────────────────────────────
    function switchTab(tab) {
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      const contentEl = document.getElementById('content-' + tab);
      const tabEl = document.getElementById('tab-' + tab);
      if (contentEl) contentEl.classList.add('active');
      if (tabEl) tabEl.classList.add('active');
    }

    // ── Toggle password visibility ─────────────────────────
    function togglePw(id, btn) {
      const inp = document.getElementById(id);
      const icon = btn.querySelector('i');
      if (inp.type === 'password') {
        inp.type = 'text';
        icon.className = 'bi bi-eye-slash text-sm';
      } else {
        inp.type = 'password';
        icon.className = 'bi bi-eye text-sm';
      }
    }

    // ── Password match indicator ───────────────────────────
    document.getElementById('pwKonfirmasi').addEventListener('input', () => {
      const baru = document.getElementById('pwBaru').value;
      const konfirmasi = document.getElementById('pwKonfirmasi').value;
      const msg = document.getElementById('pwMatchMsg');
      if (!konfirmasi) { msg.classList.add('hidden'); return; }
      msg.classList.remove('hidden');
      if (baru === konfirmasi) {
        msg.className = 'text-[11px] text-emerald-600 font-semibold';
        msg.textContent = '✅ Password cocok';
      } else {
        msg.className = 'text-[11px] text-rose-500 font-semibold';
        msg.textContent = '❌ Password tidak cocok';
      }
    });

    <% if (user && user.role === 'admin') { %>
    // ── AJAX: Tambah Karyawan ──────────────────────────────
    document.getElementById('formTambahKaryawan').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = {
        name: document.getElementById('empName').value.trim(),
        email: document.getElementById('empEmail').value.trim(),
        position: document.getElementById('empPosition').value.trim()
      };
      try {
        const res = await fetch('/pengaturan/karyawan/tambah', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          await Swal.fire({ icon: 'success', title: 'Berhasil!', text: result.message, confirmButtonColor: '#1e3a8a' });
          location.reload();
        } else {
          Swal.fire({ icon: 'error', title: 'Gagal', text: result.message, confirmButtonColor: '#dc2626' });
        }
      } catch {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Terjadi kesalahan jaringan.', confirmButtonColor: '#dc2626' });
      }
    });

    // ── Open Edit Modal ────────────────────────────────────
    function openEditModal(btn) {
      const row = btn.closest('tr');
      document.getElementById('editEmpId').value = row.dataset.id;
      document.getElementById('editEmpName').value = row.dataset.name;
      document.getElementById('editEmpEmail').value = row.dataset.email;
      document.getElementById('editEmpPosition').value = row.dataset.position;
      document.getElementById('modalEdit').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('modalEdit').classList.add('hidden');
    }

    // Tutup modal jika klik backdrop
    document.getElementById('modalEdit').addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeEditModal();
    });

    // ── AJAX: Edit Karyawan ────────────────────────────────
    document.getElementById('formEditKaryawan').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('editEmpId').value;
      const data = {
        name: document.getElementById('editEmpName').value.trim(),
        email: document.getElementById('editEmpEmail').value.trim(),
        position: document.getElementById('editEmpPosition').value.trim()
      };
      try {
        const res = await fetch(`/pengaturan/karyawan/edit/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          await Swal.fire({ icon: 'success', title: 'Berhasil!', text: result.message, confirmButtonColor: '#1e3a8a' });
          location.reload();
        } else {
          Swal.fire({ icon: 'error', title: 'Gagal', text: result.message, confirmButtonColor: '#dc2626' });
        }
      } catch {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Terjadi kesalahan jaringan.', confirmButtonColor: '#dc2626' });
      }
    });

    // ── AJAX: Hapus Karyawan ───────────────────────────────
    async function hapusKaryawan(id, nama) {
      const confirm = await Swal.fire({
        icon: 'warning',
        title: 'Hapus Karyawan?',
        html: `Anda akan menghapus karyawan <strong>${nama}</strong>.<br>Tindakan ini tidak dapat dibatalkan.`,
        showCancelButton: true,
        confirmButtonText: 'Ya, Hapus',
        cancelButtonText: 'Batal',
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#64748b'
      });
      if (!confirm.isConfirmed) return;
      try {
        const res = await fetch(`/pengaturan/karyawan/hapus/${id}`, { method: 'DELETE' });
        const result = await res.json();
        if (result.success) {
          await Swal.fire({ icon: 'success', title: 'Dihapus!', text: result.message, confirmButtonColor: '#1e3a8a' });
          location.reload();
        } else {
          Swal.fire({ icon: 'error', title: 'Gagal', text: result.message, confirmButtonColor: '#dc2626' });
        }
      } catch {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Terjadi kesalahan jaringan.', confirmButtonColor: '#dc2626' });
      }
    }
    <% } %>

    // ── AJAX: Ganti Password ───────────────────────────────
    document.getElementById('formGantiPassword').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = {
        passwordLama: document.getElementById('pwLama').value,
        passwordBaru: document.getElementById('pwBaru').value,
        konfirmasiPassword: document.getElementById('pwKonfirmasi').value
      };
      try {
        const res = await fetch('/pengaturan/profil/ganti-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          await Swal.fire({ icon: 'success', title: 'Password Diperbarui!', text: result.message, confirmButtonColor: '#1e3a8a' });
          document.getElementById('formGantiPassword').reset();
          document.getElementById('pwMatchMsg').classList.add('hidden');
        } else {
          Swal.fire({ icon: 'error', title: 'Gagal', text: result.message, confirmButtonColor: '#dc2626' });
        }
      } catch {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Terjadi kesalahan jaringan.', confirmButtonColor: '#dc2626' });
      }
    });

    <% if (user && user.role === 'admin') { %>
    // ── Search Karyawan ────────────────────────────────────
    document.getElementById('searchEmp').addEventListener('input', function () {
      const q = this.value.toLowerCase();
      document.querySelectorAll('#empTableBody tr[data-id]').forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(q) ? '' : 'none';
      });
    });
    <% } %>
  </script>
</body>
</html>
