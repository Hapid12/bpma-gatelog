<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Approval & Access - BPMA GateLog</title>
  
  <!-- Fonts & Libraries -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased overflow-hidden font-sans">
  
  <!-- Main Container -->
  <div class="flex h-screen w-screen overflow-hidden">
    
    <!-- Sidebar Kiri -->
    <aside class="w-64 bg-[#1e3a8a] border-r border-[#1e3a8a]/20 flex flex-col justify-between shrink-0 z-20">
      <div>
        <!-- Logo -->
        <div class="flex items-center px-6 py-5 border-b border-[#1e3a8a]/20">
          <svg class="w-8 h-8 mr-2.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3C12 3 6 8.5 6 13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13C18 8.5 12 3 12 3Z" fill="url(#leafGradient)"/>
            <path d="M12 8C12 8 9.5 11 9.5 13C9.5 14.3807 10.6193 15.5 12 15.5C13.3807 15.5 14.5 14.3807 14.5 13C14.5 11 12 8 12 8Z" fill="#FFFFFF"/>
            <defs>
              <linearGradient id="leafGradient" x1="6" y1="3" x2="18" y2="19" gradientUnits="userSpaceOnUse">
                <stop stop-color="#10B981"/>
                <stop stop-color="#059669"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="flex flex-col">
            <span class="text-base font-bold tracking-wider text-white">BPMA</span>
            <span class="text-xs font-semibold tracking-wide text-[#5ca82f] -mt-1">GateLog</span>
          </div>
        </div>

        <!-- Menu Sidebar -->
        <nav class="flex-1 px-4 space-y-1.5 py-6">
          <a href="/" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-grid-fill mr-3 text-base"></i>
            <span>Dashboard</span>
          </a>
          
          <a href="/visitor" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-people mr-3 text-base"></i>
            <span>Visitor</span>
          </a>
          
          <a href="/package" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-box-seam mr-3 text-base"></i>
            <span>Paket Masuk</span>
          </a>
          
          <% if (user.role === 'admin') { %>
            <a href="/appointment" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
              <i class="bi bi-calendar-event mr-3 text-base"></i>
              <span>Appointment</span>
            </a>
          <% } %>
          
          <a href="/approval" class="flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-[#5ca82f]/90 shadow-md shadow-[#5ca82f]/20 transition-all duration-200">
            <div class="flex items-center">
              <i class="bi bi-shield-check mr-3 text-base"></i>
              <span>Approval</span>
            </div>
            <span class="bg-violet-600 text-white text-xs px-2 py-0.5 rounded-full font-bold"><%= visitors.filter(v => v.status === 'approved').length %></span>
          </a>
          
          <% if (user.role === 'admin') { %>
            <a href="/laporan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
              <i class="bi bi-file-earmark-text mr-3 text-base"></i>
              <span>Laporan</span>
            </a>
            
            <a href="/audit-log" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
              <i class="bi bi-journal-code mr-3 text-base"></i>
              <span>Audit Log</span>
            </a>
          <% } %>

          <a href="/pengaturan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-gear mr-3 text-base"></i>
            <span>Pengaturan</span>
          </a>
        </nav>
      </div>

      <!-- Profil Admin/Satpam (Bawah Sidebar) -->
      <div class="p-4 border-t border-[#1e3a8a]/20">
        <a href="/logout" class="flex items-center justify-between p-2 rounded-lg hover:bg-rose-950/20 group cursor-pointer transition-colors duration-200">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-[#5ca82f] flex items-center justify-center font-bold text-white text-xs border border-[#5ca82f]">
              <%= user.name ? user.name[0].toUpperCase() : 'U' %>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-white"><%= user.name || 'User' %></span>
              <span class="text-[9px] text-blue-200 capitalize">Role: <%= user.role || 'Guest' %></span>
            </div>
          </div>
          <i class="bi bi-box-arrow-right text-blue-300 group-hover:text-rose-400 text-sm transition-colors"></i>
        </a>
      </div>
    </aside>

    <!-- Panel Konten Kanan -->
    <div class="flex-1 flex flex-col overflow-hidden bg-slate-50">
      
      <!-- Topbar -->
      <header class="h-20 bg-white/90 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-8 z-10 shrink-0">
        <div>
          <h1 class="text-xl font-bold text-slate-800 tracking-wide">Approval & Akses Visitor</h1>
          <p class="text-[11px] text-slate-600 mt-0.5">Kelola kedatangan, check-in, check-out, dan cetak pass tamu</p>
        </div>

        <div class="flex items-center space-x-6">
          <!-- Waktu Digital -->
          <div class="flex items-center space-x-3 text-xs">
            <div class="flex items-center space-x-2 bg-white border border-slate-200 px-3 py-2 rounded-lg text-slate-700">
              <i class="bi bi-calendar3 text-[#5ca82f]"></i>
              <span id="current-date" class="font-medium"></span>
            </div>
            <div class="flex items-center space-x-2 bg-white border border-slate-200 px-3 py-2 rounded-lg text-slate-700">
              <i class="bi bi-clock text-[#5ca82f]"></i>
              <span id="current-time" class="font-mono font-medium"></span>
            </div>
          </div>
        </div>
      </header>

      <!-- Area Utama Halaman -->
      <main class="flex-1 overflow-y-auto p-8 space-y-6">
        
        <!-- Judul & Pencarian -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <h2 class="text-base font-semibold text-slate-600 uppercase tracking-wider">Daftar Pertemuan Disetujui</h2>
          <div class="relative w-64">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
              <i class="bi bi-search text-slate-400 text-xs"></i>
            </span>
            <input type="text" id="searchApprovalInput" class="w-full bg-slate-50 border border-slate-200 text-xs text-slate-800 rounded-lg pl-9 pr-4 py-2 focus:outline-none focus:ring-1 focus:ring-[#1e3a8a] focus:border-transparent placeholder-slate-400" placeholder="Cari nama, instansi, atau keperluan...">
          </div>
        </div>

        <!-- Tabel Checklist Kunjungan -->
        <div class="bg-white shadow-sm border border-slate-200 rounded-xl p-5 flex flex-col justify-between min-h-[450px]">
          <div>
            <div class="overflow-x-auto">
              <table id="approvalTable" class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[10px]">
                    <th class="py-3.5 pb-3">No</th>
                    <th class="py-3.5 pb-3">Nama Tamu</th>
                    <th class="py-3.5 pb-3">Instansi</th>
                    <th class="py-3.5 pb-3">Keperluan</th>
                    <th class="py-3.5 pb-3">Pegawai Tujuan</th>
                    <th class="py-3.5 pb-3">Status</th>
                    <th class="py-3.5 pb-3">Check-In / Out</th>
                    <th class="py-3.5 pb-3 text-center">Cetak Pass</th>
                  </tr>
                </thead>
                <tbody id="approvalTableBody" class="divide-y divide-slate-100">
                  <% if (visitors.length === 0) { %>
                    <tr><td colspan="8" class="text-center py-16 text-slate-600">Belum ada data kunjungan yang di-approve.</td></tr>
                  <% } else { %>
                    <% visitors.forEach((v, i) => { %>
                      <tr class="hover:bg-slate-800/10 transition-colors text-slate-700">
                        <td class="py-3.5"><%= i + 1 %></td>
                        <td class="py-3.5">
                          <span class="font-bold text-slate-800 text-sm"><%= v.name %></span>
                          <span class="block text-[10px] text-slate-600 font-mono mt-0.5">ID: VP-<%= v._id.toString().substring(18, 24).toUpperCase() %></span>
                        </td>
                        <td class="py-3.5"><%= v.institution || v.instansi %></td>
                        <td class="py-3.5 max-w-[150px] truncate" title="<%= v.purpose %>"><%= v.purpose %></td>
                        <td class="py-3.5 text-slate-600"><%= v.targetEmployee || v.bertemu %></td>
                        <td class="py-3.5">
                          <% 
                            let badgeClass = 'bg-amber-50 text-amber-700 border border-amber-200';
                            let displayStatus = 'Approved';
                            if (v.status === 'checked-in') {
                              badgeClass = 'bg-blue-50 text-blue-700 border border-blue-200';
                              displayStatus = 'Checked-In';
                            } else if (v.status === 'checked-out') {
                              badgeClass = 'bg-slate-100 text-slate-700 border border-slate-200';
                              displayStatus = 'Checked-Out';
                            }
                          %>
                          <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-semibold tracking-wide uppercase <%= badgeClass %>">
                            <%= displayStatus %>
                          </span>
                        </td>
                        <td class="py-3.5">
                          <!-- Logika Tombol Aksi Check-in / Check-out -->
                          <% if (v.status === 'approved') { %>
                            <button onclick="checkIn('<%= v._id %>')" class="bg-[#5ca82f] hover:bg-[#4d8b26] text-white font-semibold text-[10px] px-3 py-1.5 rounded transition-all duration-200 flex items-center gap-1 shadow-sm hover:shadow">
                              <i class="bi bi-box-arrow-in-right"></i> Check-In
                            </button>
                          <% } else if (v.status === 'checked-in') { %>
                            <div class="flex flex-col space-y-1">
                              <span class="text-[9px] text-slate-500 font-mono flex items-center gap-1"><i class="bi bi-clock-history"></i> Masuk: <%= new Date(v.checkInTime).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) %></span>
                              <button onclick="checkOut('<%= v._id %>')" class="bg-rose-600 hover:bg-rose-700 text-white font-semibold text-[10px] px-3 py-1 rounded transition-all duration-200 flex items-center gap-1 shadow-sm hover:shadow w-fit">
                                <i class="bi bi-box-arrow-left"></i> Check-Out
                              </button>
                            </div>
                          <% } else if (v.status === 'checked-out') { %>
                            <div class="flex flex-col space-y-0.5 text-[9px] text-slate-500 font-mono">
                              <span>Masuk: <%= v.checkInTime ? new Date(v.checkInTime).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) : '-' %></span>
                              <span>Keluar: <%= v.checkOutTime ? new Date(v.checkOutTime).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) : '-' %></span>
                            </div>
                          <% } %>
                        </td>
                        <td class="py-3.5 text-center">
                          <!-- Tombol Cetak Pass -->
                          <button onclick="printPass('<%= v._id %>')" class="bg-white border border-slate-200 hover:border-[#1e3a8a] text-slate-700 hover:text-[#1e3a8a] hover:bg-slate-50 font-semibold text-[10px] px-2.5 py-1.5 rounded-lg shadow-sm transition-all duration-200 inline-flex items-center gap-1">
                            <i class="bi bi-printer"></i> Cetak Pass
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pagination tabel approval -->
          <div class="flex justify-between items-center mt-4 border-t border-slate-200 pt-3 text-[10px] text-slate-600 shrink-0">
            <div>Menampilkan <span class="text-slate-700 font-semibold" id="currentEntries">0</span> dari <span class="text-slate-700 font-semibold"><%= visitors.length %></span> data</div>
            <div class="flex items-center space-x-1" id="approvalPagination"></div>
            <div></div>
          </div>
        </div>

        <!-- Footer Hak Cipta -->
        <footer class="text-center text-slate-600 text-[10px] pt-12 pb-4">
          © 2026 BPMA GateLog - Sistem Informasi Manajemen Akses BPMA
        </footer>

      </main>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <script>
    // Realtime Clock
    function updateDateTime() {
      const now = new Date();
      document.getElementById('current-date').textContent = now.toLocaleDateString('id-ID', { 
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' 
      });
      document.getElementById('current-time').textContent = now.toLocaleTimeString('id-ID');
    }
    setInterval(updateDateTime, 1000);
    updateDateTime();

    // Check-In AJAX Action
    function checkIn(id) {
      Swal.fire({
        title: 'Check-In Kunjungan?',
        text: "Tamu ini akan tercatat mulai memasuki wilayah kantor BPMA.",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3b82f6',
        cancelButtonColor: '#475569',
        confirmButtonText: 'Ya, Check-In!',
        cancelButtonText: 'Batal'
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/approval/checkin/${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                Swal.fire({
                  icon: 'success',
                  title: 'Berhasil!',
                  text: 'Status tamu diubah menjadi Checked-In.',
                  confirmButtonColor: '#3b82f6'
                }).then(() => location.reload());
              } else {
                Swal.fire('Gagal!', data.error || 'Terjadi kesalahan.', 'error');
              }
            });
        }
      });
    }

    // Check-Out AJAX Action
    function checkOut(id) {
      Swal.fire({
        title: 'Check-Out Kunjungan?',
        text: "Tamu ini akan tercatat telah menyelesaikan kunjungan dan meninggalkan kantor.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#e11d48',
        cancelButtonColor: '#475569',
        confirmButtonText: 'Ya, Check-Out!',
        cancelButtonText: 'Batal'
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/approval/checkout/${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                Swal.fire({
                  icon: 'success',
                  title: 'Berhasil!',
                  text: 'Status tamu diubah menjadi Checked-Out.',
                  confirmButtonColor: '#3b82f6'
                }).then(() => location.reload());
              } else {
                Swal.fire('Gagal!', data.error || 'Terjadi kesalahan.', 'error');
              }
            });
        }
      });
    }

    // Open Printer-friendly Visitor Pass Popup Window
    function printPass(id) {
      const w = 550;
      const h = 650;
      const left = (screen.width/2)-(w/2);
      const top = (screen.height/2)-(h/2);
      window.open(`/approval/pass/${id}`, 'Cetak Visitor Pass', `width=${w},height=${h},top=${top},left=${left}`);
    }

    // Pagination & Search local filter
    function setupPaginatedSearch(tableId, paginationId, searchInputId, itemsPerPage) {
      const table = document.getElementById(tableId);
      if (!table) return;
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const pagination = document.getElementById(paginationId);
      const searchInput = document.getElementById(searchInputId);
      const entriesText = document.getElementById('currentEntries');

      let currentPage = 1;
      let filteredRows = rows;

      function showRows() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        rows.forEach(row => row.style.display = 'none');
        
        const currentSlice = filteredRows.slice(start, end);
        currentSlice.forEach(row => row.style.display = '');
        
        if (entriesText) {
          entriesText.textContent = currentSlice.length;
        }
      }

      function renderPagination() {
        pagination.innerHTML = '';
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        if (totalPages <= 1) return;
        
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.textContent = i;
          btn.className = 'w-5 h-5 rounded flex items-center justify-center text-[10px] transition-all ' + 
            (i === currentPage 
              ? 'bg-[#5ca82f] text-white font-bold' 
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 border border-slate-200');
              
          btn.onclick = () => {
            currentPage = i;
            showRows();
            renderPagination();
          };
          pagination.appendChild(btn);
        }
      }

      function filterRows() {
        const keyword = searchInput.value.toLowerCase();
        filteredRows = rows.filter(row =>
          row.textContent.toLowerCase().includes(keyword)
        );
        currentPage = 1;
        renderPagination();
        showRows();
      }

      if (searchInput) {
        searchInput.addEventListener('input', filterRows);
      }

      filterRows(); // Render pertama kali
    }

    setupPaginatedSearch('approvalTable', 'approvalPagination', 'searchApprovalInput', 10);
  </script>
</body>
</html>
