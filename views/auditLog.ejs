<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit Log - BPMA GateLog</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* Custom Timeline Styles */
    .timeline-container { position: relative; padding-left: 2.5rem; }
    .timeline-container::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 11px;
      width: 2px;
      background: #e2e8f0;
    }
    .timeline-item { position: relative; padding-bottom: 2rem; }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-icon {
      position: absolute;
      left: -2.5rem;
      top: 0.25rem;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      background: #ffffff;
      border: 2px solid #cbd5e1;
      z-index: 10;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased overflow-hidden font-sans">
  
  <div class="flex h-screen w-screen overflow-hidden">
    
    <!-- Sidebar Kiri -->
    <aside class="w-64 bg-[#1e3a8a] border-r border-[#1e3a8a]/20 flex flex-col justify-between shrink-0 z-20">
      <div>
        <div class="flex items-center px-6 py-5 border-b border-[#1e3a8a]/20">
          <svg class="w-8 h-8 mr-2.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3C12 3 6 8.5 6 13C6 16.3137 8.68629 19 12 19C15.3137 19 18 16.3137 18 13C18 8.5 12 3 12 3Z" fill="url(#leafGradient)"/>
            <path d="M12 8C12 8 9.5 11 9.5 13C9.5 14.3807 10.6193 15.5 12 15.5C13.3807 15.5 14.5 14.3807 14.5 13C14.5 11 12 8 12 8Z" fill="#FFFFFF"/>
            <defs>
              <linearGradient id="leafGradient" x1="6" y1="3" x2="18" y2="19" gradientUnits="userSpaceOnUse">
                <stop stop-color="#10B981"/>
                <stop stop-color="#059669"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="flex flex-col">
            <span class="text-base font-bold tracking-wider text-white">BPMA</span>
            <span class="text-xs font-semibold tracking-wide text-[#5ca82f] -mt-1">GateLog</span>
          </div>
        </div>

        <nav class="flex-1 px-4 space-y-1.5 py-6">
          <a href="/" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-grid-fill mr-3 text-base"></i><span>Dashboard</span>
          </a>
          <a href="/visitor" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-people mr-3 text-base"></i><span>Visitor</span>
          </a>
          <a href="/package" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-box-seam mr-3 text-base"></i><span>Paket Masuk</span>
          </a>
          <a href="/appointment" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-calendar-event mr-3 text-base"></i><span>Appointment</span>
          </a>
          <a href="/approval" class="flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <div class="flex items-center"><i class="bi bi-shield-check mr-3 text-base"></i><span>Approval</span></div>
          </a>
          <a href="/laporan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-file-earmark-text mr-3 text-base"></i><span>Laporan</span>
          </a>
          <a href="/audit-log" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-[#5ca82f]/90 shadow-md shadow-[#5ca82f]/20 transition-all duration-200">
            <i class="bi bi-journal-code mr-3 text-base"></i><span>Audit Log</span>
          </a>
          <a href="/pengaturan" class="flex items-center px-4 py-2.5 rounded-lg text-sm font-medium text-blue-200 hover:text-white hover:bg-white/10 transition-all duration-200">
            <i class="bi bi-gear mr-3 text-base"></i><span>Pengaturan</span>
          </a>
        </nav>
      </div>

      <div class="p-4 border-t border-[#1e3a8a]/20">
        <a href="/logout" class="flex items-center justify-between p-2 rounded-lg hover:bg-rose-950/20 group cursor-pointer transition-colors duration-200">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-[#5ca82f] flex items-center justify-center font-bold text-white text-xs border border-[#5ca82f]">
              <%= user.name ? user.name[0].toUpperCase() : 'U' %>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-white"><%= user.name || 'User' %></span>
              <span class="text-[9px] text-blue-200 capitalize">Role: <%= user.role || 'Guest' %></span>
            </div>
          </div>
          <i class="bi bi-box-arrow-right text-blue-300 group-hover:text-rose-400 text-sm transition-colors"></i>
        </a>
      </div>
    </aside>

    <!-- Panel Konten Kanan -->
    <div class="flex-1 flex flex-col overflow-hidden bg-slate-50">
      
      <!-- Topbar -->
      <header class="h-20 bg-white/90 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-8 z-10 shrink-0">
        <div>
          <h1 class="text-xl font-bold text-slate-800 tracking-wide">Audit Log</h1>
          <p class="text-[11px] text-slate-600 mt-0.5">Pemantauan aktivitas pengguna sistem secara real-time</p>
        </div>
      </header>

      <!-- Area Utama Halaman -->
      <main class="flex-1 overflow-y-auto p-8 space-y-6">
        
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex gap-2">
            <span class="bg-blue-500/10 text-[#5ca82f] border border-[#5ca82f]/20 text-[10px] px-3 py-1 rounded-full font-medium tracking-wide">Total Logs: <%= logs.length %></span>
            <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] px-3 py-1 rounded-full font-medium tracking-wide">Sistem Aman</span>
          </div>
          <div class="relative w-64">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
              <i class="bi bi-search text-slate-600 text-xs"></i>
            </span>
            <input type="text" id="searchLog" class="w-full bg-white border border-slate-200 text-xs text-slate-800 rounded-lg pl-9 pr-4 py-2 focus:outline-none focus:border-[#5ca82f]" placeholder="Cari aksi, entitas, atau user...">
          </div>
        </div>

        <!-- Timeline Log Container -->
        <div class="bg-white shadow-sm border border-slate-200 rounded-xl p-6 md:p-8">
          
          <% if (logs.length === 0) { %>
            <div class="text-center py-12">
              <i class="bi bi-journal-x text-4xl text-slate-600 mb-3 block"></i>
              <p class="text-slate-600 text-sm">Belum ada riwayat aktivitas tercatat.</p>
            </div>
          <% } else { %>
            <div class="timeline-container mt-2">
              <% logs.forEach(log => { %>
                
                <% 
                  // Tentukan warna icon berdasarkan jenis aksi
                  let iconColorClass = 'text-slate-600 border-slate-600';
                  let iconSymbol = 'bi-record-circle';
                  
                  if (log.action === 'LOGIN') { iconColorClass = 'text-[#5ca82f] border-[#5ca82f] bg-green-50'; iconSymbol = 'bi-box-arrow-in-right'; }
                  else if (log.action === 'LOGOUT') { iconColorClass = 'text-slate-500 border-slate-300 bg-slate-100'; iconSymbol = 'bi-box-arrow-right'; }
                  else if (log.action === 'CREATE') { iconColorClass = 'text-emerald-600 border-emerald-300 bg-emerald-50'; iconSymbol = 'bi-plus-lg'; }
                  else if (log.action === 'UPDATE') { iconColorClass = 'text-amber-600 border-amber-300 bg-amber-50'; iconSymbol = 'bi-pencil'; }
                  else if (log.action === 'DELETE') { iconColorClass = 'text-rose-600 border-rose-300 bg-rose-50'; iconSymbol = 'bi-trash'; }
                  else if (log.action === 'CHECK_IN') { iconColorClass = 'text-emerald-600 border-emerald-300 bg-emerald-50'; iconSymbol = 'bi-door-open'; }
                  else if (log.action === 'CHECK_OUT') { iconColorClass = 'text-indigo-600 border-indigo-300 bg-indigo-50'; iconSymbol = 'bi-door-closed'; }
                  else if (log.action === 'UPDATE_STATUS') { iconColorClass = 'text-cyan-600 border-cyan-300 bg-cyan-50'; iconSymbol = 'bi-arrow-repeat'; }
                %>

                <div class="timeline-item log-entry">
                  <div class="timeline-icon <%= iconColorClass %>">
                    <i class="bi <%= iconSymbol %>"></i>
                  </div>
                  <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 hover:bg-slate-100/50 transition-all shadow-sm">
                    <div class="flex flex-col md:flex-row justify-between md:items-center mb-1.5 gap-2">
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-slate-800 text-xs"><%= log.user %></span>
                        <span class="bg-[#1e3a8a]/10 text-[#1e3a8a] text-[9px] px-2 py-0.5 rounded font-semibold capitalize tracking-wide"><%= log.role %></span>
                        <span class="text-slate-400 text-xs mx-1">•</span>
                        <span class="bg-[#5ca82f]/10 text-[#5ca82f] font-mono font-bold text-[10px] px-2 py-0.5 rounded"><%= log.action %></span>
                        <span class="text-slate-500 text-xs font-medium"><%= log.entity %></span>
                      </div>
                      <span class="text-slate-500 text-[10px] font-mono"><%= new Date(log.timestamp).toLocaleString('id-ID', {day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit', second:'2-digit'}) %></span>
                    </div>
                    <p class="text-slate-700 text-xs leading-relaxed log-details"><%= log.details %></p>
                  </div>
                </div>

              <% }) %>
            </div>
          <% } %>

        </div>

        <footer class="text-center text-slate-600 text-[10px] pt-12 pb-4">
          © 2026 BPMA GateLog - Sistem Manajemen Akses & Keamanan
        </footer>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Fitur pencarian simpel untuk log
    document.getElementById('searchLog').addEventListener('input', function(e) {
      const keyword = e.target.value.toLowerCase();
      const entries = document.querySelectorAll('.log-entry');
      entries.forEach(entry => {
        const text = entry.innerText.toLowerCase();
        entry.style.display = text.includes(keyword) ? '' : 'none';
      });
    });
  </script>
</body>
</html>
